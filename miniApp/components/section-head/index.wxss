.head {
  display: flex;
  min-height: 72rpx;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.head__copy {
  min-width: 0;
  flex: 1;
}

.head__title,
.head__subtitle {
  display: block;
}

.head__title {
  color: #1b241f;
  font-size: 34rpx;
  font-weight: 850;
  line-height: 1.35;
}

.head__subtitle {
  margin-top: 8rpx;
  color: #69776f;
  font-size: 24rpx;
  line-height: 1.5;
}

.head__action {
  display: flex;
  height: 52rpx;
  align-items: center;
  gap: 4rpx;
  color: #159b55;
  font-size: 24rpx;
  font-weight: 750;
}
