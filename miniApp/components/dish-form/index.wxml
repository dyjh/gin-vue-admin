<wxs module="array" src="../../wxs/array.wxs" />
<view class="form-page">
  <view class="card form-card form-card--cover">
    <view class="form-card__head">
      <text class="form-title">菜品封面</text>
      <text class="required-pill">必填</text>
    </view>
    <view class="cover-editor">
      <button class="cover-editor__preview" bindtap="chooseCover">
        <image wx:if="{{form.coverUrl}}" class="cover-editor__image" src="{{form.coverUrl}}" mode="aspectFill" />
        <view wx:else class="cover-editor__empty">
          <app-icon name="image" tone="green" size="{{25}}" />
          <text>选择封面</text>
        </view>
      </button>
      <view class="cover-editor__actions">
        <view class="cover-editor__buttons">
          <button class="cover-action cover-action--outline" bindtap="chooseCover">
            <app-icon name="upload" tone="green" size="{{15}}" />
            <text>{{form.coverUrl ? "更换封面" : "上传封面"}}</text>
          </button>
          <button wx:if="{{coverFeature}}" class="cover-action cover-action--soft" loading="{{generating}}" bindtap="generateCover">
            <app-icon name="sparkles" tone="green" size="{{15}}" />
            <text>{{form.coverUrl ? "重新" + coverFeature.actionText : coverFeature.actionText}}</text>
          </button>
        </view>
        <text class="field__help">{{coverFeature ? coverFeature.description : "封面图必选，请上传真实照片"}}</text>
        <text wx:if="{{coverFeature && coverFeature.costHint}}" class="field__help">{{coverFeature.costHint}}</text>
      </view>
    </view>
    <view class="form-divider"></view>
    <view class="intro-heading">
      <text class="form-subtitle">简介</text>
      <text class="optional-pill">可选</text>
    </view>
    <textarea
      class="field__control intro-control"
      maxlength="180"
      value="{{form.description}}"
      data-field="description"
      placeholder="可以写口味、亮点、适合场景，也可以先空着"
      bindinput="inputField"
    />
  </view>

  <view class="card form-card form-card--basic">
    <text wx:if="{{mode == 'edit'}}" class="form-title basic-title">基础信息</text>
    <view class="form-row">
      <text class="form-row__label">菜名</text>
      <input class="form-row__input" value="{{form.name}}" data-field="name" placeholder="例如：香菇鸡腿饭" bindinput="inputField" />
    </view>
    <view class="form-row">
      <text class="form-row__label">分类</text>
      <picker class="form-row__picker" mode="selector" range="{{categories}}" value="{{array.indexOf(categories, form.category)}}" bindchange="chooseCategory">
        <view class="form-row__control">
          <text class="value-pill">{{form.category}}</text>
          <app-icon name="chevron-right" tone="gray" size="{{16}}" />
        </view>
      </picker>
    </view>
    <view class="form-row form-row--tags">
      <text class="form-row__label">标签</text>
      <button class="form-row__control form-row__control--button" bindtap="toggleTagPicker">
        <view class="selected-tags">
          <text wx:if="{{!form.tags.length}}" class="form-row__placeholder">选择最多 3 个标签</text>
          <text wx:for="{{form.tags}}" wx:key="*this" class="value-pill">{{item}}</text>
        </view>
        <app-icon name="chevron-right" tone="gray" size="{{16}}" />
      </button>
    </view>
    <view wx:if="{{showTagOptions}}" class="tag-picker">
      <button
        wx:for="{{tagOptions}}"
        wx:key="*this"
        class="tag {{array.includes(form.tags, item) ? 'tag--selected' : 'tag--outline'}}"
        data-tag="{{item}}"
        bindtap="toggleTag"
      >{{item}}</button>
    </view>
    <view class="form-row form-row--last">
      <text class="form-row__label">基础份量</text>
      <picker class="form-row__picker" mode="selector" range="{{[1,2,3,4,5,6]}}" value="{{form.serving - 1}}" bindchange="chooseServing">
        <view class="form-row__control form-row__control--boxed">
          <text>1 份适合 {{form.serving}} 人</text>
          <app-icon name="chevron-right" tone="gray" size="{{16}}" />
        </view>
      </picker>
    </view>
  </view>

  <view class="card form-card">
    <view class="block-head">
      <view>
        <text class="form-title">主要配料</text>
        <text class="field__help">按 1 份填写</text>
      </view>
      <text class="soft-pill">按 1 份</text>
    </view>
    <view class="ingredient-row" wx:for="{{form.ingredients}}" wx:key="id">
      <input class="ingredient-row__name" value="{{item.name}}" placeholder="配料名称" data-index="{{index}}" data-field="name" bindinput="ingredientInput" />
      <input class="ingredient-row__amount" value="{{item.amount}}" placeholder="用量" data-index="{{index}}" data-field="amount" bindinput="ingredientInput" />
      <input class="ingredient-row__amount" value="{{item.unit}}" placeholder="单位" data-index="{{index}}" data-field="unit" bindinput="ingredientInput" />
      <button class="ingredient-row__remove" aria-label="移除配料" data-index="{{index}}" bindtap="removeIngredient">
        <app-icon name="minus" tone="danger" size="{{16}}" />
      </button>
    </view>
    <button class="inline-add" bindtap="addIngredient">
      <app-icon name="plus" tone="green" size="{{16}}" />
      <text>添加配料</text>
    </button>
  </view>

  <view class="card form-card form-card--steps">
    <view class="block-head">
      <view>
        <text class="form-title">做法步骤</text>
        <text class="field__help">可只写文字，步骤图可选</text>
      </view>
      <button class="btn btn--soft btn--small block-add" bindtap="addStep">
        <app-icon name="plus" tone="green" size="{{16}}" />
        <text>添加步骤</text>
      </button>
    </view>
    <view class="step-editor" wx:for="{{form.steps}}" wx:key="id">
      <view class="step-editor__number">{{index + 1}}</view>
      <view class="step-editor__body">
        <textarea class="field__control step-editor__text" value="{{item.text}}" placeholder="写下这一步怎么做" data-index="{{index}}" bindinput="stepInput" />
        <button class="step-editor__photo" data-index="{{index}}" bindtap="chooseStepImage">
          <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" />
          <view wx:else>
            <app-icon name="image" tone="green" size="{{18}}" />
            <text>添加步骤图（选填）</text>
          </view>
        </button>
      </view>
      <button class="step-editor__remove" aria-label="移除步骤" data-index="{{index}}" bindtap="removeStep">
        <app-icon name="trash" tone="gray" size="{{17}}" />
      </button>
    </view>
  </view>

  <view class="bottom-dock form-save-dock">
    <view class="bottom-dock__row">
      <button class="btn btn--outline" data-status="draft" bindtap="save">保存草稿</button>
      <button class="btn btn--primary" data-status="usable" bindtap="save">保存为可用菜品</button>
    </view>
    <text class="save-hint">可用后才能加入菜谱和饭局</text>
  </view>
</view>
