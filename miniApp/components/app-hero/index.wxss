.hero {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: #fdf6ed;
}

.hero__image,
.hero__veil {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero__veil {
  background: linear-gradient(90deg, rgba(253, 246, 237, 0.96) 0%, rgba(253, 246, 237, 0.72) 40%, rgba(253, 246, 237, 0) 68%);
  pointer-events: none;
}

.hero__back {
  position: absolute;
  z-index: 3;
  left: 22rpx;
  display: flex;
  width: 66rpx;
  align-items: center;
  justify-content: center;
}

.hero__copy {
  position: absolute;
  z-index: 2;
  left: 32rpx;
  width: 55%;
}

.hero__copy--back {
  left: 92rpx;
  width: 49%;
}

.hero__title,
.hero__subtitle {
  display: block;
}

.hero__title {
  color: #151f1a;
  font-size: 42rpx;
  font-weight: 850;
  line-height: 1.2;
}

.hero__subtitle {
  margin-top: 10rpx;
  color: #6f7d76;
  font-size: 23rpx;
  line-height: 1.45;
}
