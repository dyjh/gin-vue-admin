.hero {
  position: relative;
  width: 100%;
  height: 402rpx;
  overflow: hidden;
  background: #fdf6ed;
}

.hero__image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero__back {
  position: absolute;
  z-index: 3;
  left: 20rpx;
  display: flex;
  width: 66rpx;
  align-items: center;
  justify-content: center;
}

.hero__copy {
  position: absolute;
  z-index: 2;
  left: 40rpx;
  width: 55%;
}

.hero__copy--back {
  left: 114rpx;
  width: 52%;
}

.hero__title,
.hero__subtitle {
  display: block;
  letter-spacing: 0;
}

.hero__title {
  color: #151f1a;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
}

.hero__subtitle {
  margin-top: 14rpx;
  color: #56645c;
  font-size: 26rpx;
  font-weight: 400;
  overflow: hidden;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}
