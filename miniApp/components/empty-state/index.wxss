.empty {
  display: flex;
  min-height: 360rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
  text-align: center;
}

.empty__icon {
  display: flex;
  width: 84rpx;
  height: 84rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #e9f8ef;
}

.empty__title {
  margin-top: 24rpx;
  color: #1b241f;
  font-size: 30rpx;
  font-weight: 800;
}

.empty__desc {
  max-width: 520rpx;
  margin-top: 12rpx;
  color: #7b8982;
  font-size: 24rpx;
  line-height: 1.6;
}

.empty__action {
  display: inline-flex;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
  padding: 0 28rpx;
  border: 1rpx solid #9fcfb2;
  border-radius: 999rpx;
  color: #159b55;
  font-size: 25rpx;
  font-weight: 750;
  line-height: 1;
}
