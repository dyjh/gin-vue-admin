{
  "name": "来干饭微信小程序 API 接口清单",
  "version": "1.0.0",
  "generatedAt": "2026-07-18",
  "source": [
    "aiDoc/prd/family-menu-miniapp-prd.md",
    "aiDoc/prd/family-menu-miniapp-feature-mindmap.md",
    "aiDoc/prd/dish-and-recipe-creation-flowchart.md",
    "aiDoc/prd/meal-order-to-purchase-flowchart.md",
    "miniApp/task.json"
  ],
  "basePath": "/api/miniapp/v1",
  "transport": {
    "protocol": "HTTPS",
    "contentType": "application/json",
    "authorization": "Bearer <accessToken>",
    "traceHeader": "X-Request-Id",
    "mutationIdempotencyHeader": "X-Idempotency-Key"
  },
  "responseEnvelope": {
    "success": {
      "code": 0,
      "data": "object|array|null",
      "msg": "ok"
    },
    "error": {
      "code": "non-zero integer",
      "data": null,
      "msg": "human-readable message"
    }
  },
  "pagination": {
    "request": {
      "page": "number, starts at 1",
      "pageSize": "number, default 20"
    },
    "response": {
      "page": "number",
      "pageSize": "number",
      "total": "number",
      "list": "array"
    },
    "clientBehavior": "界面不展示页码；接近底部加载下一页；切换筛选和下拉刷新时重置为第 1 页；追加时按 id 去重。"
  },
  "commonErrorCodes": {
    "40001": "请求参数错误",
    "40101": "登录已过期",
    "40301": "无权操作该资源",
    "40401": "资源不存在",
    "40901": "状态冲突或重复操作",
    "42201": "图片内容审核不通过",
    "42901": "请求过于频繁",
    "47001": "积分不足",
    "47002": "AI 功能未解锁",
    "47003": "AI 任务失败，积分已退还"
  },
  "enums": {
    "DishStatus": [
      "draft",
      "usable"
    ],
    "RecommendationSourceType": [
      "official",
      "creator"
    ],
    "MealStatus": [
      "collecting",
      "closed",
      "confirmed",
      "cancelled",
      "expired"
    ],
    "PointEntryType": [
      "earned",
      "spent",
      "refund"
    ],
    "NotificationType": [
      "governance",
      "discoverability",
      "points",
      "ai_refund",
      "meal"
    ]
  },
  "models": {
    "Profile": {
      "id": "string",
      "nickname": "string",
      "avatarUrl": "string|null",
      "points": "number",
      "checkinDays": "number"
    },
    "Ingredient": {
      "id": "string",
      "name": "string",
      "amount": "string",
      "sortOrder": "number"
    },
    "DishStep": {
      "id": "string",
      "text": "string",
      "imageUrl": "string|null",
      "sortOrder": "number"
    },
    "DishSummary": {
      "id": "string",
      "name": "string",
      "category": "string",
      "tags": "string[]",
      "coverUrl": "string",
      "serving": "number",
      "status": "DishStatus",
      "discoverable": "boolean",
      "sourceLocked": "boolean"
    },
    "Dish": {
      "allOf": [
        "DishSummary"
      ],
      "description": "string|null",
      "ingredients": "Ingredient[]",
      "steps": "DishStep[]",
      "createdAt": "datetime",
      "updatedAt": "datetime"
    },
    "DishUpsertInput": {
      "name": "string|required|max:40",
      "category": "string|required",
      "tags": "string[]|maxItems:3",
      "serving": "number|required|min:1|max:20",
      "description": "string|optional|max:180",
      "coverFileId": "string|required",
      "status": "draft|usable|required",
      "ingredients": "IngredientInput[]",
      "steps": "DishStepInput[]"
    },
    "RecommendationSummary": {
      "allOf": [
        "DishSummary"
      ],
      "recommendationId": "string",
      "sourceType": "official|creator",
      "author": "AuthorSummary",
      "copied": "boolean"
    },
    "Recommendation": {
      "allOf": [
        "RecommendationSummary"
      ],
      "description": "string",
      "ingredients": "Ingredient[]",
      "steps": "DishStep[]"
    },
    "RecipeSummary": {
      "id": "string",
      "name": "string",
      "note": "string|null",
      "dishCount": "number",
      "coverUrls": "string[]"
    },
    "Recipe": {
      "allOf": [
        "RecipeSummary"
      ],
      "dishIds": "string[]",
      "dishes": "DishSummary[]",
      "updatedAt": "datetime"
    },
    "Checkin": {
      "id": "string",
      "dishId": "string|null",
      "dishName": "string",
      "imageUrl": "string",
      "note": "string|null",
      "checkedAt": "datetime",
      "rewarded": "boolean"
    },
    "MealSummary": {
      "id": "string",
      "name": "string",
      "code": "string",
      "status": "MealStatus",
      "deadlineAt": "datetime",
      "participantCount": "number",
      "candidateCount": "number"
    },
    "Meal": {
      "allOf": [
        "MealSummary"
      ],
      "candidateDishIds": "string[]",
      "candidates": "MealCandidate[]",
      "createdByMe": "boolean"
    },
    "ShoppingItem": {
      "id": "string",
      "name": "string",
      "amount": "string",
      "note": "string|null",
      "completed": "boolean",
      "sortOrder": "number"
    },
    "ShoppingList": {
      "id": "string",
      "meal": "MealSummary",
      "items": "ShoppingItem[]",
      "pendingCount": "number",
      "completedCount": "number"
    },
    "AiUsageResult": {
      "usageId": "string",
      "pointCost": "number",
      "refunded": "boolean",
      "pointBalance": "number"
    },
    "AiRecommendation": {
      "id": "string",
      "source": "library|ai",
      "sourceLabel": "string",
      "reason": "string",
      "dish": "Recommendation",
      "usage": "AiUsageResult"
    },
    "PrepPlan": {
      "id": "string",
      "mealId": "string",
      "estimatedMinutes": "number",
      "steps": "PrepStep[]",
      "usage": "AiUsageResult"
    },
    "PointEntry": {
      "id": "string",
      "type": "PointEntryType",
      "title": "string",
      "description": "string",
      "amount": "number",
      "relatedEntryId": "string|null",
      "createdAt": "datetime"
    },
    "AiUsage": {
      "id": "string",
      "feature": "string",
      "pointCost": "number",
      "status": "success|failed|refunded",
      "createdAt": "datetime"
    },
    "Notification": {
      "id": "string",
      "type": "NotificationType",
      "title": "string",
      "content": "string",
      "targetType": "string|null",
      "targetId": "string|null",
      "read": "boolean",
      "createdAt": "datetime"
    },
    "BootstrapData": {
      "profile": "Profile",
      "dishes": "DishSummary[0..3]",
      "recommendations": "RecommendationSummary[0..5]",
      "activeMeal": "MealSummary|null",
      "unreadCount": "number"
    }
  },
  "interfaces": [
    {
      "id": "bootstrap_get",
      "module": "system",
      "name": "小程序启动聚合数据",
      "method": "GET",
      "path": "/bootstrap",
      "auth": true,
      "usedBy": [
        "pages/home/index",
        "pages/profile/index"
      ],
      "request": {},
      "response": {
        "$ref": "BootstrapData"
      },
      "rules": [
        "仅返回首屏所需的小集合；我的菜品最多 3 条，推荐菜品最多 5 条。"
      ]
    },
    {
      "id": "auth_wx_login",
      "module": "auth",
      "name": "微信登录",
      "method": "POST",
      "path": "/auth/wx-login",
      "auth": false,
      "usedBy": [
        "app.js"
      ],
      "request": {
        "body": {
          "code": "string|required",
          "encryptedData": "string|optional",
          "iv": "string|optional"
        }
      },
      "response": {
        "accessToken": "string",
        "expiresIn": "number",
        "isNewUser": "boolean",
        "profile": {
          "$ref": "Profile"
        }
      },
      "idempotency": {
        "header": "X-Idempotency-Key",
        "required": true
      },
      "rules": [
        "服务端以微信 code 换取会话，不接受客户端直接提交 openid。"
      ]
    },
    {
      "id": "profile_get",
      "module": "profile",
      "name": "获取个人资料",
      "method": "GET",
      "path": "/profile",
      "auth": true,
      "usedBy": [
        "pages/profile/index"
      ],
      "request": {},
      "response": {
        "$ref": "Profile"
      },
      "rules": []
    },
    {
      "id": "profile_update",
      "module": "profile",
      "name": "更新头像昵称",
      "method": "PUT",
      "path": "/profile",
      "auth": true,
      "usedBy": [
        "pages/profile/index"
      ],
      "request": {
        "body": {
          "nickname": "string|required|max:30",
          "avatarFileId": "string|optional"
        }
      },
      "response": {
        "$ref": "Profile"
      },
      "idempotency": {
        "header": "X-Idempotency-Key",
        "required": true
      },
      "rules": [
        "昵称使用微信 nickname 输入能力或手工输入；头像先经过图片上传接口。"
      ]
    },
    {
      "id": "metadata_get",
      "module": "system",
      "name": "获取分类、标签、单位与 AI 配置",
      "method": "GET",
      "path": "/metadata",
      "auth": true,
      "usedBy": [
        "pages/dish/add-entry",
        "pages/dish/edit",
        "pages/recommend/dishes",
        "pages/recommend/dish-detail",
        "pages/ai/what-to-eat",
        "pages/ai/what-to-eat-detail"
      ],
      "request": {},
      "response": {
        "dishCategories": "DishCategory[]",
        "dishTags": "DishTag[]",
        "ingredientUnits": "string[]",
        "aiCosts": "Record<string, number>",
        "featureFlags": "Record<string, boolean>"
      },
      "rules": [
        "V1 分类和标签由平台配置，用户不能自定义分类。"
      ]
    },
    {
      "id": "image_upload",
      "module": "upload",
      "name": "上传业务图片并同步内容审核",
      "method": "POST",
      "path": "/uploads/images",
      "auth": true,
      "usedBy": [
        "pages/dish/add-entry",
        "pages/dish/edit",
        "pages/checkin/index"
      ],
      "request": {
        "multipart": {
          "file": "binary|required",
          "scene": "profile_avatar|dish_cover|dish_step|dish_recognition|checkin|required"
        }
      },
      "response": {
        "fileId": "string",
        "url": "string",
        "width": "number",
        "height": "number",
        "reviewStatus": "passed|rejected",
        "rejectReason": "string|null"
      },
      "idempotency": {
        "header": "X-Idempotency-Key",
        "required": true
      },
      "rules": [
        "上传阶段同步审核；审核失败当场返回，不进入通知中心。",
        "客户端压缩后上传，服务端仍需校验 MIME、大小与图片内容。"
      ]
    },
    {
      "id": "dish_list",
      "module": "dish",
      "name": "分页查询个人菜品",
      "method": "GET",
      "path": "/dishes",
      "auth": true,
      "usedBy": [
        "pages/home/index",
        "pages/dish/list",
        "pages/dish/add-entry",
        "pages/dish/edit",
        "pages/recipes/index",
        "pages/recipes/detail",
        "pages/meal/create",
        "pages/meal/invite",
        "pages/meal/vote",
        "pages/meal/stats",
        "pages/profile/index"
      ],
      "request": {
        "query": {
          "page": "number|default:1",
          "pageSize": "number|default:20|max:100",
          "q": "string|optional",
          "category": "string|optional",
          "status": "draft|usable|optional"
        }
      },
      "response": {
        "$ref": "Page<DishSummary>"
      },
      "pagination": {
        "request": [
          "page",
          "pageSize"
        ],
        "response": [
          "page",
          "pageSize",
          "total",
          "list"
        ],
        "defaultPageSize": 20
      },
      "rules": [
        "只返回当前用户有权查看的个人菜品。",
        "列表按 updatedAt 倒序。"
      ]
    },
    {
      "id": "dish_detail",
      "module": "dish",
      "name": "获取个人菜品详情",
      "method": "GET",
      "path": "/dishes/{dishId}",
      "auth": true,
      "usedBy": [
        "pages/dish/detail",
        "pages/dish/add-entry",
        "pages/dish/edit"
      ],
      "request": {
        "path": {
          "dishId": "string|required"
        }
      },
      "response": {
        "$ref": "Dish"
      },
      "rules": []
    },
    {
      "id": "dish_create",
      "module": "dish",
      "name": "创建个人菜品",
      "method": "POST",
      "path": "/dishes",
      "auth": true,
      "usedBy": [
        "pages/dish/add-entry"
      ],
      "request": {
        "body": {
          "$ref": "DishUpsertInput"
        }
      },
      "response": {
        "$ref": "Dish"
      },
      "idempotency": {
        "header": "X-Idempotency-Key",
        "required": true
      },
      "rules": [
        "封面图必填；简介选填；标签最多 3 个。",
        "可保存为 draft 或 usable。"
      ]
    },
    {
      "id": "dish_update",
      "module": "dish",
      "name": "编辑个人菜品",
      "method": "PUT",
      "path": "/dishes/{dishId}",
      "auth": true,
      "usedBy": [
        "pages/dish/edit"
      ],
      "request": {
        "path": {
          "dishId": "string|required"
        },
        "body": {
          "$ref": "DishUpsertInput"
        }
      },
      "response": {
        "$ref": "Dish"
      },
      "idempotency": {
        "header": "X-Idempotency-Key",
        "required": true
      },
      "rules": [
        "从推荐或 AI 保存的菜品可编辑内容，但 sourceLocked 永久为 true。"
      ]
    },
    {
      "id": "dish_delete",
      "module": "dish",
      "name": "删除个人菜品",
      "method": "DELETE",
      "path": "/dishes/{dishId}",
      "auth": true,
      "usedBy": [
        "pages/dish/detail"
      ],
      "request": {
        "path": {
          "dishId": "string|required"
        }
      },
      "response": {
        "deleted": "boolean",
        "affectedRecipeCount": "number",
        "affectedMealCount": "number"
      },
      "idempotency": {
        "header": "X-Idempotency-Key",
        "required": true
      },
      "rules": [
        "删除菜品时从菜谱和未关闭饭局候选中移除引用。"
      ]
    },
    {
      "id": "dish_discoverable_update",
      "module": "dish",
      "name": "设置允许被发现",
      "method": "PUT",
      "path": "/dishes/{dishId}/discoverable",
      "auth": true,
      "usedBy": [
        "pages/dish/detail"
      ],
      "request": {
        "path": {
          "dishId": "string|required"
        },
        "body": {
          "discoverable": "boolean|required"
        }
      },
      "response": {
        "$ref": "Dish"
      },
      "idempotency": {
        "header": "X-Idempotency-Key",
        "required": true
      },
      "rules": [
        "界面口径为“允许被发现/未公开”，不使用“公开状态”或单独审核。",
        "sourceLocked=true 的菜品不能设置为允许被发现。",
        "管理员加入推荐即完成挑选行为，不设置独立审核状态。"
      ]
    },
    {
      "id": "dish_ai_recognition",
      "module": "ai",
      "name": "AI 识别菜谱并返回可编辑字段",
      "method": "POST",
      "path": "/ai/dish-recognition",
      "auth": true,
      "usedBy": [
        "pages/dish/add-entry"
      ],
      "request": {
        "body": {
          "text": "string|optional",
          "imageFileId": "string|optional"
        }
      },
      "response": {
        "dishDraft": {
          "$ref": "DishUpsertInput"
        },
        "usage": {
          "$ref": "AiUsageResult"
        }
      },
      "idempotency": {
        "header": "X-Idempotency-Key",
        "required": true
      },
      "rules": [
        "text 与 imageFileId 至少提供一个。",
        "识别结果仅填充表单，用户确认保存后才创建菜品。",
        "AI 失败或超时产生独立积分退还流水。"
      ]
    },
    {
      "id": "dish_ai_cover_generate",
      "module": "ai",
      "name": "AI 生成菜品封面",
      "method": "POST",
      "path": "/ai/dish-cover",
      "auth": true,
      "usedBy": [
        "pages/dish/add-entry",
        "pages/dish/edit"
      ],
      "request": {
        "body": {
          "name": "string|required",
          "description": "string|optional",
          "category": "string|optional"
        }
      },
      "response": {
        "fileId": "string",
        "url": "string",
        "usage": {
          "$ref": "AiUsageResult"
        }
      },
      "idempotency": {
        "header": "X-Idempotency-Key",
        "required": true
      },
      "rules": [
        "生成图应表现真实菜品，不使用简陋矢量占位图。"
      ]
    },
    {
      "id": "recommendation_list",
      "module": "recommendation",
      "name": "分页查询菜品推荐",
      "method": "GET",
      "path": "/recommendations",
      "auth": true,
      "usedBy": [
        "pages/home/index",
        "pages/recommend/dishes"
      ],
      "request": {
        "query": {
          "page": "number|default:1",
          "pageSize": "number|default:20",
          "category": "string|optional",
          "tags": "string[]|optional"
        }
      },
      "response": {
        "$ref": "Page<RecommendationSummary>"
      },
      "pagination": {
        "request": [
          "page",
          "pageSize"
        ],
        "response": [
          "page",
          "pageSize",
          "total",
          "list"
        ],
        "defaultPageSize": 20
      },
      "rules": [
        "推荐来源必须区分 official 与 creator。",
        "仅返回管理员当前挑选进入推荐的菜品。"
      ]
    },
    {
      "id": "recommendation_detail",
      "module": "recommendation",
      "name": "获取推荐菜品详情",
      "method": "GET",
      "path": "/recommendations/{recommendationId}",
      "auth": true,
      "usedBy": [
        "pages/recommend/dish-detail"
      ],
      "request": {
        "path": {
          "recommendationId": "string|required"
        }
      },
      "response": {
        "$ref": "Recommendation"
      },
      "rules": [
        "详情只读并展示作者；平台发布时展示官方身份。"
      ]
    },
    {
      "id": "recommendation_copy",
      "module": "recommendation",
      "name": "复制推荐菜品到个人菜品库",
      "method": "POST",
      "path": "/recommendations/{recommendationId}/copy",
      "auth": true,
      "usedBy": [
        "pages/home/index",
        "pages/recommend/dish-detail"
      ],
      "request": {
        "path": {
          "recommendationId": "string|required"
        }
      },
      "response": {
        "dish": {
          "$ref": "Dish"
        },
        "alreadyCopied": "boolean"
      },
      "idempotency": {
        "header": "X-Idempotency-Key",
        "required": true
      },
      "rules": [
        "复制后可编辑、默认未公开、sourceLocked=true，永久不能再次允许被发现。",
        "重复请求返回已有复制结果。"
      ]
    },
    {
      "id": "what_to_eat_status",
      "module": "ai",
      "name": "获取不知道吃什么可用状态",
      "method": "GET",
      "path": "/ai/what-to-eat/status",
      "auth": true,
      "usedBy": [
        "pages/ai/what-to-eat"
      ],
      "request": {},
      "response": {
        "unlocked": "boolean",
        "checkinDays": "number",
        "unlockDays": "number",
        "freeQuota": "number",
        "pointBalance": "number",
        "pointCost": "number"
      },
      "rules": [
        "累计做菜打卡满 7 天后解锁。"
      ]
    },
    {
      "id": "what_to_eat_generate",
      "module": "ai",
      "name": "生成个性化菜品推荐",
      "method": "POST",
      "path": "/ai/what-to-eat",
      "auth": true,
      "usedBy": [
        "pages/ai/what-to-eat"
      ],
      "request": {
        "body": {
          "tags": "string[]",
          "people": "number|required",
          "timeLimitMinutes": "number|optional",
          "excludedRecommendationIds": "string[]|optional",
          "useFreeQuota": "boolean"
        }
      },
      "response": {
        "$ref": "AiRecommendation"
      },
      "idempotency": {
        "header": "X-Idempotency-Key",
        "required": true
      },
      "rules": [
