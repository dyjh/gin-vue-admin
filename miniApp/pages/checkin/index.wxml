<view class="page checkin-page">
  <app-hero
    image="/assets/images/checkin-cat-photographing-v1.jpg"
    title="做菜打卡"
    subtitle="记下今天亲手做的一餐"
  />

  <view class="checkin-content">
    <view class="calendar-panel">
      <view class="calendar-nav">
        <button class="calendar-nav__button" data-offset="-1" bindtap="changeMonth" aria-label="上个月">
          <app-icon name="arrow-left" tone="gray" size="{{17}}" />
        </button>
        <text class="calendar-nav__title">{{displayMonth}}</text>
        <text class="calendar-nav__count">本月 {{monthCheckinCount}} 次</text>
        <button class="calendar-nav__button" data-offset="1" bindtap="changeMonth" aria-label="下个月">
          <app-icon name="chevron-right" tone="gray" size="{{17}}" />
        </button>
      </view>

      <view class="calendar-week">
        <text wx:for="{{weekLabels}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="calendar-grid">
        <button
          wx:for="{{calendar}}"
          wx:key="key"
          class="calendar-day {{item.selected ? 'calendar-day--selected' : ''}} {{item.today ? 'calendar-day--today' : ''}}"
          data-date="{{item.date}}"
          disabled="{{!item.day}}"
          bindtap="selectDate"
        >
          <text wx:if="{{item.day}}">{{item.day}}</text>
          <view wx:if="{{item.checked && !item.selected}}" class="calendar-day__dot"></view>
        </button>
      </view>

      <view class="calendar-panel__footer">
        <view class="calendar-legend"><view class="calendar-legend__dot"></view><text>有打卡记录</text></view>
        <text>累计打卡 {{totalCheckinDays}} 天</text>
      </view>
    </view>

    <view class="history-section">
      <view class="history-section__head">
        <text class="history-section__date">{{selectedDateLabel}}</text>
        <text class="history-section__count">{{selectedCheckins.length}} 次打卡</text>
      </view>

      <view class="checkin-list">
        <view
          class="checkin-card"
          wx:for="{{selectedCheckins}}"
          wx:key="id"
        >
          <image src="{{item.imageUrl}}" mode="aspectFill" />
          <view class="checkin-card__body">
            <text class="checkin-card__title">{{item.dishName}}</text>
            <text class="checkin-card__meta">{{item.displayTime}} · {{item.note || '完成一次做菜记录'}}</text>
            <text class="checkin-card__reward {{item.rewarded ? '' : 'checkin-card__reward--gray'}}">
              {{item.rewarded ? '首次 · +5积分' : '已记录'}}
            </text>
          </view>
        </view>

        <empty-state
          wx:if="{{!selectedCheckins.length}}"
          icon="calendar"
          title="这天还没有打卡"
          description="选一个有绿色圆点的日期查看记录。"
        />
      </view>

      <view wx:if="{{selectedCheckins.length && selectedRewardClaimed}}" class="reward-note">
        <view class="reward-note__icon"><app-icon name="check" tone="green" size="{{17}}" /></view>
        <view>
          <text class="reward-note__title">{{rewardMessage}}</text>
          <text class="reward-note__desc">仍可继续打卡，但该日不会重复发放积分</text>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-dock">
    <button class="btn btn--primary" bindtap="openAdd">
      <app-icon name="camera" tone="white" size="{{20}}" />
      <text>新增打卡</text>
    </button>
  </view>

  <view wx:if="{{showAdd}}" class="sheet-mask" bindtap="closeAdd">
    <view class="sheet checkin-sheet" catchtap="noop">
      <view class="sheet__handle"></view>
      <view class="checkin-sheet__head">
        <view>
          <text class="checkin-sheet__title">新增打卡</text>
          <text class="checkin-sheet__date">{{formDateLabel}}</text>
        </view>
        <button class="checkin-sheet__close" bindtap="closeAdd" aria-label="关闭">
          <app-icon name="close" tone="gray" size="{{20}}" />
        </button>
      </view>

      <view class="checkin-field">
        <view class="checkin-field__label">
          <text>做菜照片</text>
          <text class="required-chip">必填</text>
        </view>

        <button wx:if="{{!photo}}" class="checkin-photo checkin-photo--empty" bindtap="choosePhoto">
          <view class="checkin-photo__camera"><app-icon name="camera" tone="green" size="{{25}}" /></view>
          <text class="checkin-photo__title">上传做菜照片</text>
          <text class="checkin-photo__hint">上传后将进行图片内容检查</text>
        </button>

        <view wx:else class="checkin-photo checkin-photo--filled">
          <image src="{{photo}}" mode="aspectFill" />
          <view class="checkin-photo__status">
            <app-icon name="check" tone="green" size="{{13}}" />
            <text>检查通过</text>
          </view>
          <view class="checkin-photo__actions">
            <button bindtap="choosePhoto">更换</button>
            <button class="checkin-photo__delete" bindtap="removePhoto" aria-label="删除照片">
              <app-icon name="trash" tone="danger" size="{{16}}" />
            </button>
          </view>
        </view>
      </view>

      <view class="checkin-field">
        <view class="checkin-field__label">
          <text>菜名</text>
          <text class="required-chip">必填</text>
        </view>
        <view class="checkin-input {{dishName ? 'checkin-input--filled' : ''}}">
          <input value="{{dishName}}" maxlength="30" placeholder="输入这道菜的名字" bindinput="inputDishName" />
          <app-icon wx:if="{{dishName}}" name="check" tone="green" size="{{17}}" />
        </view>
      </view>

      <view class="checkin-field">
        <view class="checkin-field__label">
          <text>备注</text>
          <text class="optional-label">选填</text>
        </view>
        <view class="checkin-note">
          <textarea value="{{note}}" maxlength="100" placeholder="今天这道菜怎么样？" bindinput="inputNote" />
          <text>{{note.length}} / 100</text>
        </view>
      </view>

      <button class="btn btn--primary checkin-sheet__submit" disabled="{{!canSubmit}}" loading="{{submitting}}" bindtap="submit">
        {{canSubmit ? '完成打卡' : '请先完善必填项'}}
      </button>
      <text class="checkin-sheet__help">每天可多次打卡，仅当天第一条有效记录奖励积分</text>
    </view>
  </view>

  <view wx:if="{{showSuccess}}" class="sheet-mask" catchtap="noop">
    <view class="sheet checkin-success" catchtap="noop">
      <view class="sheet__handle"></view>
      <view class="checkin-success__icon"><app-icon name="check" tone="green" size="{{29}}" /></view>
      <text class="checkin-success__title">打卡成功</text>
      <text class="checkin-success__date">{{successDateLabel}}</text>

      <view wx:if="{{successRewardPoints}}" class="checkin-success__reward">
        <text class="checkin-success__points">+{{successRewardPoints}}</text>
        <view>
          <text>今日首次打卡奖励</text>
          <text>积分已到账，可在积分流水中查看</text>
        </view>
      </view>

      <view wx:if="{{successCheckin}}" class="checkin-success__dish">
        <image src="{{successCheckin.imageUrl}}" mode="aspectFill" />
        <view>
          <text>{{successCheckin.dishName}}</text>
          <text>{{successCheckin.note || '完成一次做菜记录'}}</text>
          <text class="checkin-success__recorded">已记录</text>
        </view>
      </view>

      <text class="checkin-success__hint">去添加菜品只会预填菜名，不会带入打卡照片</text>
      <view class="checkin-success__actions">
        <button class="btn btn--outline" bindtap="addAsDish">去添加菜品</button>
        <button class="btn btn--primary" bindtap="finishSuccess">完成</button>
      </view>
    </view>
  </view>
</view>
