.calendar-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.calendar-week,
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
}

.calendar-week {
  margin-top: 26rpx;
  color: #8a958f;
  font-size: 21rpx;
  text-align: center;
}

.calendar-grid {
  row-gap: 16rpx;
  margin-top: 18rpx;
}

.calendar-day {
  position: relative;
  display: flex;
  width: 58rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  justify-self: center;
  border-radius: 50%;
  color: #526159;
  font-size: 23rpx;
}

.calendar-day--today {
  border: 2rpx solid #159b55;
  color: #159b55;
  font-weight: 800;
}

.calendar-day--checked {
  background: #20b866;
  color: #fff;
  font-weight: 800;
}

.calendar-day--checked app-icon {
  position: absolute;
  right: -3rpx;
  bottom: -3rpx;
  display: flex;
  width: 22rpx;
  height: 22rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #fff;
  border-radius: 50%;
  background: #159b55;
}

.checkin-list {
  margin-top: 16rpx;
}

.checkin-row {
  display: grid;
  min-height: 150rpx;
  grid-template-columns: 124rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf1ee;
}

.checkin-row > image {
  width: 124rpx;
  height: 112rpx;
  border-radius: 16rpx;
}

.checkin-row__note {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  color: #526159;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.checkin-sheet {
  max-height: 88vh;
}

.checkin-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.checkin-photo {
  display: flex;
  width: 100%;
  height: 250rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 2rpx dashed #add4bd;
  border-radius: 20rpx;
  background: #f7fbf8;
}

.checkin-photo image {
  width: 100%;
  height: 100%;
}

.checkin-photo view {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  color: #159b55;
  font-size: 24rpx;
  font-weight: 750;
}
