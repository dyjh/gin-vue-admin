<view class="profile-page page-shell">
  <view class="user-card">
    <view class="avatar">饭</view>
    <view class="user-info">
      <text class="user-name">我的厨房账号</text>
      <text class="user-meta">积分 128 · 累计打卡 6 天</text>
    </view>
  </view>

  <view class="action-list">
    <view
      class="action-row"
      wx:for="{{actions}}"
      wx:key="id"
      data-name="{{item.name}}"
      bindtap="onActionTap"
    >
      <view>
        <text class="action-name">{{item.name}}</text>
        <text class="action-desc">{{item.desc}}</text>
      </view>
      <text class="action-arrow">›</text>
    </view>
  </view>

  <view class="custom-tabbar">
    <view class="tab-item" bindtap="goHome">
      <view class="tab-icon home"></view>
      <text>首页</text>
    </view>
    <view class="tab-item" bindtap="goRecipes">
      <view class="tab-icon recipe"></view>
      <text>菜谱</text>
    </view>
    <view class="tab-item active">
      <view class="tab-icon mine"></view>
      <text>我的</text>
    </view>
  </view>
</view>
