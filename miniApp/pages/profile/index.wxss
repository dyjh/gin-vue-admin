.profile-page {
  padding-bottom: 40rpx;
  background: #fff;
}

.profile-hero {
  position: relative;
  height: 402rpx;
  overflow: hidden;
  background: #fdf6ed;
}

.profile-hero__image {
  display: block;
  width: 100%;
  height: auto;
  transform: translateY(18rpx);
}

.profile-identity {
  position: absolute;
  left: 32rpx;
  display: flex;
  width: 420rpx;
  align-items: center;
  gap: 18rpx;
  text-align: left;
}

.profile-identity__avatar {
  display: flex;
  width: 82rpx;
  height: 82rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 5rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  background: #e8f7ee;
  color: #159b55;
  font-size: 34rpx;
  font-weight: 850;
}

.profile-identity__avatar image {
  width: 100%;
  height: 100%;
}

.profile-identity__copy {
  min-width: 0;
  flex: 1;
}

.profile-identity__name,
.profile-identity__meta {
  display: block;
}

.profile-identity__name {
  font-size: 37rpx;
  font-weight: 850;
}

.profile-identity__meta {
  margin-top: 6rpx;
  color: #6f7d76;
  font-size: 22rpx;
}

.profile-stats {
  display: flex;
  height: 130rpx;
  align-items: center;
  border-bottom: 14rpx solid #f3f6f4;
  background: #fff;
}

.profile-stats button {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.profile-stats__value,
.profile-stats__label {
  display: block;
}

.profile-stats__value {
  font-size: 36rpx;
  font-weight: 850;
}

.profile-stats__label {
  color: #77847d;
  font-size: 21rpx;
}

.profile-stats__divider {
  width: 1rpx;
  height: 66rpx;
  background: #e4e9e6;
}

.profile-band {
  padding: 30rpx 32rpx;
  border-bottom: 14rpx solid #f3f6f4;
  background: #fff;
}

.profile-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 31rpx;
  font-weight: 850;
}

.profile-section-head button {
  display: flex;
  align-items: center;
  gap: 4rpx;
  color: #159b55;
  font-size: 23rpx;
}

.profile-meal-band {
  padding-bottom: 26rpx;
}

.profile-meal-status {
  display: flex;
  min-height: 44rpx;
  align-items: center;
  gap: 8rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #e9f8ef;
  color: #159b55;
  font-size: 20rpx;
  font-weight: 750;
}

.profile-meal-status .status-dot {
  width: 10rpx;
  height: 10rpx;
}

.active-meal {
  display: flex;
  width: 100%;
  min-height: 112rpx;
  margin-top: 18rpx;
  align-items: center;
  gap: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: #f1faf4;
  text-align: left;
}

.active-meal__icon {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #fff;
}

.active-meal__body {
  min-width: 0;
  flex: 1;
}

.active-meal__name,
.active-meal__meta {
  display: block;
}

.active-meal__name {
  overflow: hidden;
  color: #1f2d25;
  font-size: 28rpx;
  font-weight: 850;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.active-meal__meta {
  margin-top: 9rpx;
  overflow: hidden;
  color: #6f7e76;
  font-size: 20rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.active-meal__enter {
  display: flex;
  flex: none;
  align-items: center;
  gap: 2rpx;
  color: #159b55;
  font-size: 21rpx;
  font-weight: 750;
}

.profile-empty-meal {
  padding: 28rpx 0 10rpx;
}

.profile-section-title {
  display: block;
  margin-bottom: 24rpx;
  font-size: 31rpx;
  font-weight: 850;
}

.quick-actions {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
}

.quick-actions button {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  border-right: 1rpx solid #edf1ee;
  font-size: 25rpx;
  font-weight: 750;
}

.quick-actions button:last-child {
  border-right: 0;
}

.quick-actions button > view {
  display: flex;
  width: 66rpx;
  height: 66rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #e7f6ed;
}

.quick-actions button:first-child > view {
  background: #159b55;
}

.profile-services {
  border-bottom: 0;
}

.service-row {
  display: flex;
  width: 100%;
  height: 104rpx;
  align-items: center;
  gap: 18rpx;
  border-bottom: 1rpx solid #edf1ee;
  font-size: 27rpx;
  font-weight: 750;
}

.service-row__icon {
  display: flex;
  width: 62rpx;
  height: 62rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #eff8f2;
}

.service-row__meta {
  margin-left: auto;
  color: #8a958f;
  font-size: 22rpx;
  font-weight: 500;
}

.profile-editor-row {
  display: flex;
  min-height: 120rpx;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #edf1ee;
  font-size: 28rpx;
  font-weight: 750;
}

.profile-editor-avatar {
  display: flex;
  width: 78rpx;
  height: 78rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 50%;
  background: #e8f7ee;
  color: #159b55;
  font-size: 30rpx;
  font-weight: 850;
}

.profile-editor-avatar image {
  width: 100%;
  height: 100%;
}

.profile-editor-row input {
  width: 430rpx;
  height: 76rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  background: #f7faf8;
  font-size: 26rpx;
  text-align: right;
}

.profile-editor-row + .btn {
  margin-top: 30rpx;
}
