.profile-page {
  padding-bottom: 40rpx;
  background: #fff;
}

.profile-hero {
  position: relative;
  height: 402rpx;
  overflow: hidden;
  background: #fdf6ed;
}

.profile-hero__image {
  display: block;
  width: 100%;
  height: auto;
  transform: translateY(18rpx);
}

.profile-identity {
  position: absolute;
  left: 32rpx;
  display: flex;
  width: 390rpx;
  align-items: center;
  gap: 16rpx;
  text-align: left;
}

.profile-identity__avatar {
  display: flex;
  width: 74rpx;
  height: 74rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 5rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  background: #e8f7ee;
  color: #159b55;
  font-size: 31rpx;
  font-weight: 850;
}

.profile-identity__avatar image {
  width: 100%;
  height: 100%;
}

.profile-identity__copy {
  min-width: 0;
  flex: 1;
}

.profile-identity__name,
.profile-identity__meta {
  display: block;
}

.profile-identity__name {
  font-size: 34rpx;
  font-weight: 850;
}

.profile-identity__meta {
  margin-top: 6rpx;
  color: #6f7d76;
  font-size: 21rpx;
}

.profile-stats {
  display: flex;
  height: 130rpx;
  align-items: center;
  border-bottom: 14rpx solid #f3f6f4;
  background: #fff;
}

.profile-stats button {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.profile-stats__value,
.profile-stats__label {
  display: block;
}

.profile-stats__value {
  font-size: 36rpx;
  font-weight: 850;
}

.profile-stats__label {
  color: #77847d;
  font-size: 21rpx;
}

.profile-stats__divider {
  width: 1rpx;
  height: 66rpx;
  background: #e4e9e6;
}

.profile-band {
  padding: 30rpx 32rpx;
  border-bottom: 14rpx solid #f3f6f4;
  background: #fff;
}

.profile-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 31rpx;
  font-weight: 850;
}

.profile-section-head button {
  display: flex;
  align-items: center;
  gap: 4rpx;
  color: #159b55;
  font-size: 23rpx;
}

.active-meal {
  width: 100%;
  margin-top: 22rpx;
  text-align: left;
}

.active-meal__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 31rpx;
  font-weight: 850;
}

.active-meal__top .pill {
  gap: 8rpx;
  font-size: 20rpx;
}

.active-meal__meta {
  display: block;
  margin-top: 10rpx;
  color: #7b8982;
  font-size: 22rpx;
}

.active-meal__deadline {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf1ee;
  color: #526159;
  font-size: 22rpx;
}

.profile-empty-meal {
  padding: 28rpx 0 10rpx;
}

.profile-section-title {
  display: block;
  margin-bottom: 24rpx;
  font-size: 31rpx;
  font-weight: 850;
}

.quick-actions {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
}

.quick-actions button {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  border-right: 1rpx solid #edf1ee;
  font-size: 25rpx;
  font-weight: 750;
}

.quick-actions button:last-child {
  border-right: 0;
}

.quick-actions button > view {
  display: flex;
  width: 66rpx;
  height: 66rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #e7f6ed;
}

.quick-actions button:first-child > view {
  background: #159b55;
}

.profile-services {
  border-bottom: 0;
}

.service-row {
  display: flex;
  width: 100%;
  height: 104rpx;
  align-items: center;
  gap: 18rpx;
  border-bottom: 1rpx solid #edf1ee;
  font-size: 27rpx;
  font-weight: 750;
}

.service-row__icon {
  display: flex;
  width: 62rpx;
  height: 62rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #eff8f2;
}

.service-row__meta {
  margin-left: auto;
  color: #8a958f;
  font-size: 22rpx;
  font-weight: 500;
}

.profile-editor-row {
  display: flex;
  min-height: 120rpx;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #edf1ee;
  font-size: 28rpx;
  font-weight: 750;
}

.profile-editor-avatar {
  display: flex;
  width: 78rpx;
  height: 78rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 50%;
  background: #e8f7ee;
  color: #159b55;
  font-size: 30rpx;
  font-weight: 850;
}

.profile-editor-avatar image {
  width: 100%;
  height: 100%;
}

.profile-editor-row input {
  width: 430rpx;
  height: 76rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  background: #f7faf8;
  font-size: 26rpx;
  text-align: right;
}

.profile-editor-row + .btn {
  margin-top: 30rpx;
}
