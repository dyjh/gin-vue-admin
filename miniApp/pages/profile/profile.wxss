.profile-page {
  padding: 34rpx 24rpx 0;
  box-sizing: border-box;
  background: #f7fbf3;
}

.user-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 32rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, #ffffff, #e9f8c9);
  box-shadow: 0 14rpx 34rpx rgba(36, 80, 62, 0.07);
}

.avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 32rpx;
  color: #ffffff;
  background: #16c875;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 92rpx;
  text-align: center;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name,
.user-meta {
  display: block;
}

.user-name {
  color: #213830;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.25;
}

.user-meta {
  margin-top: 12rpx;
  color: #71817b;
  font-size: 24rpx;
  line-height: 1.3;
}

.action-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 24rpx;
}

.action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(36, 80, 62, 0.06);
}

.action-name,
.action-desc {
  display: block;
}

.action-name {
  color: #213830;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.25;
}

.action-desc {
  margin-top: 10rpx;
  color: #7f8d87;
  font-size: 24rpx;
  line-height: 1.35;
}

.action-arrow {
  flex: none;
  color: #13aa66;
  font-size: 42rpx;
  line-height: 1;
}
