.stats-page {
  padding-bottom: calc(250rpx + env(safe-area-inset-bottom));
  background: #f8faf7;
}

.stats-main {
  padding: 32rpx 32rpx 40rpx;
}

.stats-summary {
  padding: 24rpx 28rpx 22rpx;
  border: 1rpx solid #e9efeb;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 12rpx 32rpx rgba(16, 38, 26, 0.045);
}

.stats-summary__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.stats-summary__name {
  overflow: hidden;
  font-size: 34rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stats-summary__status {
  flex: none;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #fff5e9;
  color: #c87f27;
  font-size: 20rpx;
  font-weight: 600;
}

.stats-summary__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 30rpx;
  margin-top: 30rpx;
}

.stats-summary__meta > view {
  display: flex;
  align-items: center;
  gap: 9rpx;
  color: #6f7d76;
  font-size: 20rpx;
}

.stats-suggestion {
  display: flex;
  min-height: 116rpx;
  align-items: center;
  gap: 20rpx;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #eff8f2;
}

.stats-suggestion__icon {
  display: flex;
  width: 60rpx;
  height: 60rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #dff3e7;
}

.stats-suggestion__title,
.stats-suggestion__desc {
  display: block;
}

.stats-suggestion__title {
  font-size: 24rpx;
  font-weight: 700;
}

.stats-suggestion__desc {
  margin-top: 9rpx;
  color: #6f7d76;
  font-size: 19rpx;
}

.stats-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 30rpx;
  padding: 0 2rpx;
}

.stats-heading__title,
.stats-heading__subtitle {
  display: block;
}

.stats-heading__title {
  font-size: 36rpx;
  font-weight: 700;
}

.stats-heading__subtitle {
  margin-top: 8rpx;
  color: #8a9690;
  font-size: 20rpx;
}

.stats-heading__sort {
  flex: none;
  margin-top: 8rpx;
  color: #7b8982;
  font-size: 20rpx;
}

.stats-list {
  margin-top: 18rpx;
}

.stats-card {
  display: grid;
  min-height: 216rpx;
  grid-template-columns: 116rpx minmax(0, 1fr) 190rpx;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 20rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #e9efeb;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 12rpx 32rpx rgba(16, 38, 26, 0.045);
}

.stats-card--excluded .stats-card__image {
  opacity: 0.46;
}

.stats-card--excluded .stats-card__name {
  color: #7f8b84;
}

.stats-card--excluded .stats-card__votes,
.stats-card--excluded .stats-card__base {
  color: #9aa59f;
}

.stats-card--excluded .stats-card__suggestion {
  background: #f0f3f1;
  color: #8f9a94;
}

.stats-card__image {
  width: 116rpx;
  height: 116rpx;
  border-radius: 14rpx;
  background: #eef3ef;
}

.stats-card__body {
  min-width: 0;
}

.stats-card__name,
.stats-card__votes,
.stats-card__base,
.stats-card__suggestion {
  display: block;
}

.stats-card__name {
  overflow: hidden;
  font-size: 27rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stats-card__votes {
  margin-top: 10rpx;
  color: #159b55;
  font-size: 20rpx;
  font-weight: 600;
}

.stats-card__base {
  margin-top: 11rpx;
  color: #7b8982;
  font-size: 18rpx;
}

.stats-card__suggestion {
  width: 116rpx;
  margin-top: 10rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: #eaf7ef;
  color: #159b55;
  font-size: 18rpx;
  font-weight: 600;
  text-align: center;
}

.stats-card__control {
  display: flex;
  min-height: 164rpx;
  flex-direction: column;
  justify-content: space-between;
  padding-left: 18rpx;
  border-left: 1rpx solid #edf1ee;
}

.stats-card__decision {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #526159;
  font-size: 20rpx;
  font-weight: 600;
}

.include-toggle {
  position: relative;
  width: 72rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: #dce5df;
}

.include-toggle view {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(16, 38, 26, 0.14);
}

.include-toggle--active {
  background: #20b866;
}

.include-toggle--active view {
  left: 36rpx;
}

.stats-card__servings {
  width: 100%;
}

.stats-card__servings > text {
  display: block;
  margin-bottom: 10rpx;
  color: #8a9690;
  font-size: 18rpx;
}

.final-stepper {
  display: grid;
  width: 100%;
  height: 60rpx;
  grid-template-columns: 52rpx 1fr 52rpx;
  align-items: center;
  overflow: hidden;
  border: 1rpx solid #dde7e1;
  border-radius: 14rpx;
  background: #f7faf8;
}
.final-stepper button {
  display: flex;
  width: 100%;
  height: 40rpx;
  align-items: center;
  justify-content: center;
}

.final-stepper button:first-child {
  border-right: 1rpx solid #e3e9e5;
}

.final-stepper button:last-child {
  border-left: 1rpx solid #e3e9e5;
}

.final-stepper > text {
  font-size: 27rpx;
  font-weight: 700;
  text-align: center;
}

.final-stepper--disabled {
  opacity: 0.46;
}

.stats-dock {
  z-index: 45;
  padding-top: 20rpx;
}

.stats-dock__summary,
.stats-dock__hint {
  display: block;
}

.stats-dock__summary {
  margin-bottom: 18rpx;
  font-size: 25rpx;
  font-weight: 700;
}

.stats-dock .btn {
  width: 100%;
}

.stats-dock__hint {
  margin-top: 16rpx;
  color: #8b9690;
  font-size: 18rpx;
  text-align: center;
}

.stats-confirm {
  padding-top: 22rpx;
}

.stats-confirm__head {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.stats-confirm__icon {
  display: flex;
  width: 80rpx;
  height: 80rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #eaf7ef;
}

.stats-confirm__title,
.stats-confirm__subtitle {
  display: block;
}

.stats-confirm__title {
  font-size: 36rpx;
  font-weight: 700;
}

.stats-confirm__subtitle {
  margin-top: 9rpx;
  color: #7b8982;
  font-size: 20rpx;
}

.stats-confirm__totals {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-top: 28rpx;
  padding: 28rpx 0;
  border-top: 1rpx solid #eef1ee;
  border-bottom: 1rpx solid #eef1ee;
}

.stats-confirm__totals > view {
  border-right: 1rpx solid #eef1ee;
  text-align: center;
}

.stats-confirm__totals > view:last-child {
  border-right: 0;
}

.stats-confirm__totals text {
  display: block;
}

.stats-confirm__totals text:first-child {
  font-size: 38rpx;
  font-weight: 700;
}

.stats-confirm__totals text:last-child {
  margin-top: 8rpx;
  color: #7b8982;
  font-size: 18rpx;
}

.stats-confirm__notes {
  padding: 24rpx 0;
}

.stats-confirm__notes > view {
  display: flex;
  min-height: 58rpx;
  align-items: center;
  gap: 16rpx;
  color: #48554e;
  font-size: 22rpx;
}

.stats-confirm__notes > view > view {
  display: flex;
  width: 32rpx;
  height: 32rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #eaf7ef;
}

.stats-confirm__actions {
  display: grid;
  grid-template-columns: 0.75fr 1.25fr;
  gap: 20rpx;
}

.stats-confirm__actions .btn {
  height: 92rpx;
  padding: 0 20rpx;
  font-size: 27rpx;
}

.stats-confirm__hint {
  display: block;
  margin-top: 24rpx;
  color: #8a9690;
  font-size: 18rpx;
  text-align: center;
}