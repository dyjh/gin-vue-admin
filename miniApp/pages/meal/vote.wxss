.vote-page {
  min-height: 100vh;
  padding-bottom: 140rpx;
  background: #fff;
}

.join-content {
  padding: 22rpx 24rpx 80rpx;
  background: #f8faf7;
}

.join-card {
  min-height: 0;
  padding: 28rpx 28rpx 26rpx;
  text-align: left;
}

.join-card__head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.join-card__icon {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #eaf7ef;
}

.join-card__title,
.join-card__subtitle {
  display: block;
}

.join-card__title {
  color: #1b241f;
  font-size: 34rpx;
  font-weight: 850;
}

.join-card__subtitle {
  margin-top: 5rpx;
  color: #7b8982;
  font-size: 21rpx;
}

.join-card__input {
  box-sizing: border-box;
  width: 100%;
  height: 108rpx;
  margin: 32rpx 0 26rpx;
  border: 2rpx solid #d7e4db;
  border-radius: 20rpx;
  background: #fbfdfb;
  color: #26352d;
  font-size: 52rpx;
  font-weight: 850;
  letter-spacing: 12rpx;
  text-align: center;
}

.join-match {
  display: flex;
  min-height: 76rpx;
  align-items: center;
  gap: 12rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  font-size: 22rpx;
  font-weight: 750;
}

.join-match--idle { visibility: hidden; }
.join-match--checking { background: #f3f6f4; color: #6f7d76; }
.join-match--success { background: #eff8f2; color: #159b55; }
.join-match--error { background: #fff1f0; color: #c9534e; }

.join-card .btn { width: 100%; }

.join-card__button {
  height: 96rpx;
  margin-top: 20rpx;
}

.join-card__button--disabled { opacity: 0.45; }

.join-card__help {
  display: block;
  margin-top: 20rpx;
  text-align: center;
}

.join-benefits { margin-top: 54rpx; }

.join-benefits__title {
  display: block;
  margin: 0 8rpx 18rpx;
  color: #1b241f;
  font-size: 32rpx;
  font-weight: 850;
}

.join-benefits__list {
  overflow: hidden;
  border: 1rpx solid #e9efeb;
  border-radius: 14rpx;
  background: #fff;
}

.join-benefit {
  display: flex;
  min-height: 132rpx;
  align-items: center;
  gap: 20rpx;
  margin-left: 28rpx;
  padding-right: 28rpx;
}

.join-benefit + .join-benefit { border-top: 1rpx solid #eef1ee; }

.join-benefit__icon {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #eaf7ef;
}

.join-benefit__title,
.join-benefit__desc { display: block; }

.join-benefit__title {
  color: #1b241f;
  font-size: 25rpx;
  font-weight: 800;
}

.join-benefit__desc {
  margin-top: 7rpx;
  color: #7b8982;
  font-size: 19rpx;
}
.vote-summary {
  padding: 28rpx 32rpx 26rpx;
  border-bottom: 1rpx solid #e6ece8;
  background: #fff;
}

.vote-summary__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 34rpx;
  font-weight: 850;
}

.vote-summary__top .pill {
  gap: 8rpx;
  font-size: 21rpx;
}

.vote-summary__meta {
  display: block;
  margin-top: 8rpx;
  color: #7b8982;
  font-size: 22rpx;
}

.vote-summary__deadline {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
  color: #526159;
  font-size: 22rpx;
}

.meal-subscription {
  display: inline-flex;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 20rpx;
  padding: 0 24rpx;
  border: 1rpx solid #9bd4b2;
  border-radius: 999rpx;
  background: #eff9f3;
  color: #159b55;
  font-size: 22rpx;
  font-weight: 750;
}

.vote-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 26rpx 32rpx 16rpx;
  background: #fff;
}

.order-panel {
  display: grid;
  height: 900rpx;
  grid-template-columns: 160rpx minmax(0, 1fr);
  overflow: hidden;
  border-top: 1rpx solid #edf1ee;
  background: #fff;
}

.order-panel__categories {
  height: 100%;
  background: #f2f6f3;
}

.order-panel__categories button {
  position: relative;
  display: flex;
  width: 100%;
  min-height: 112rpx;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 8rpx;
  padding-left: 32rpx;
  color: #526159;
  text-align: left;
}

.order-panel__categories button text:first-child {
  font-size: 26rpx;
  font-weight: 750;
}

.order-panel__categories button text:last-child {
  color: #8a958f;
  font-size: 19rpx;
}

.order-panel__categories button.active {
  background: #fff;
  color: #159b55;
}

.order-panel__categories button.active::before {
  position: absolute;
  top: 26rpx;
  bottom: 26rpx;
  left: 0;
  width: 6rpx;
  border-radius: 0 6rpx 6rpx 0;
  background: #20b866;
  content: "";
}

.order-panel__dishes {
  height: 100%;
  padding: 0 26rpx;
}

.order-panel__title {
  display: block;
  padding: 26rpx 0 8rpx;
  font-size: 29rpx;
  font-weight: 850;
}

.vote-dock {
  position: fixed;
  z-index: 50;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  min-height: 112rpx;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #dfe8e2;
  background: #f0f8f3;
}

.vote-dock__count,
.vote-dock__hint {
  display: block;
}

.vote-dock__count {
  font-size: 26rpx;
  font-weight: 850;
}

.vote-dock__hint {
  margin-top: 5rpx;
  color: #7b8982;
  font-size: 19rpx;
}

.vote-dock__button {
  display: flex;
  height: 76rpx;
  align-items: center;
  gap: 12rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #20b866, #0a8e52);
  color: #fff;
  font-size: 25rpx;
  font-weight: 800;
}
