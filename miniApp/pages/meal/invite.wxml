<view wx:if="{{meal}}" class="page invite-page">
  <app-hero
    image="/assets/images/meal-invite-cat-numeric-code-v3.jpg"
    title="饭局点餐码"
    subtitle="分享点餐码，邀请大家一起选菜"
  />

  <view class="invite-content">
    <view class="invite-panel invite-summary">
      <view class="invite-summary__head">
        <text class="invite-summary__name">{{meal.name}}</text>
        <view class="invite-status {{meal.status === 'collecting' ? '' : 'invite-status--closed'}}">
          <view class="status-dot"></view>
          <text>{{meal.status === "collecting" ? "点餐收集中" : "点餐已关闭"}}</text>
        </view>
      </view>
      <view class="invite-summary__meta">
        <view>
          <app-icon name="qr-code" tone="green" size="{{15}}" />
          <text>{{meal.candidateCount}} 道候选菜</text>
        </view>
        <view>
          <app-icon name="clock" tone="green" size="{{15}}" />
          <text>{{meal.deadlineLabel}} 截止</text>
        </view>
      </view>
    </view>

    <view class="invite-panel code-card">
      <view class="code-card__head">
        <view>
          <text class="code-card__title">点餐码</text>
          <text class="code-card__subtitle">让朋友在小程序中输入这组号码</text>
        </view>
        <view class="code-card__availability">
          <app-icon name="{{meal.status === 'collecting' ? 'unlock' : 'lock'}}" tone="{{meal.status === 'collecting' ? 'green' : 'gray'}}" size="{{14}}" />
          <text>{{meal.status === "collecting" ? "可加入" : "不可加入"}}</text>
        </view>
      </view>

      <view class="code-digits" aria-label="六位点餐码 {{meal.code}}">
        <view wx:for="{{codeDigits}}" wx:key="index" class="code-digit">{{item}}</view>
      </view>

      <button class="copy-code" bindtap="copyCode">
        <app-icon name="copy" tone="green" size="{{17}}" />
        <text>复制点餐码</text>
      </button>

      <block wx:if="{{meal.status === 'collecting'}}">
        <view class="code-card__divider"></view>

        <view class="countdown-tip">
          <app-icon name="clock" tone="green" size="{{20}}" />
          <view>
            <text class="countdown-tip__title">{{remainingLabel}}</text>
            <text class="countdown-tip__meta">到期后自动关闭，点餐码不能重新开启</text>
          </view>
        </view>

        <button class="share-button" open-type="share">
          <app-icon name="share" tone="white" size="{{20}}" />
          <text>分享给微信好友</text>
        </button>
      </block>
    </view>

    <button class="invite-panel candidate-entry" bindtap="openCandidates">
      <text class="candidate-entry__title">候选菜</text>
      <view class="candidate-entry__aside">
        <text>{{meal.candidateCount}} 道</text>
        <app-icon name="chevron-right" tone="gray" size="{{18}}" />
      </view>
    </button>
  </view>

  <view class="bottom-dock invite-dock">
    <block wx:if="{{meal.status === 'collecting'}}">
      <button class="close-meal" loading="{{closing}}" disabled="{{closing || cancelling}}" bindtap="openCloseConfirm">
        <app-icon name="circle-stop-solid" tone="danger" size="{{26}}" />
        <text>提前关闭点餐</text>
      </button>
      <text class="invite-dock__help">关闭后只停止点餐，饭局仍在进行中</text>
      <button
        wx:if="{{meal.createdByMe}}"
        class="cancel-meal"
        loading="{{cancelling}}"
        disabled="{{closing || cancelling}}"
        bindtap="openCancelConfirm"
      >取消这场饭局</button>
    </block>
    <block wx:elif="{{meal.status === 'closed'}}">
      <button class="btn btn--primary" bindtap="openStats">查看点菜统计</button>
      <text class="invite-dock__help">点餐已关闭，饭局仍在进行中；确认菜单后进入采购</text>
      <button
        wx:if="{{meal.createdByMe}}"
        class="cancel-meal"
        loading="{{cancelling}}"
        disabled="{{cancelling}}"
        bindtap="openCancelConfirm"
      >取消这场饭局</button>
    </block>
    <block wx:else>
      <text class="invite-dock__help">当前饭局仍在进行中</text>
    </block>
  </view>

  <view wx:if="{{showCandidates}}" class="sheet-mask" bindtap="closeCandidates">
    <view
      class="sheet candidate-sheet {{candidateSheetDragging ? 'candidate-sheet--dragging' : ''}}"
      style="transform: translateY({{candidateSheetOffset}}px);"
      catchtap="noop"
    >
      <view
        class="candidate-sheet__drag-handle"
        bindtouchstart="startCandidateDrag"
        catchtouchmove="moveCandidateDrag"
        bindtouchend="endCandidateDrag"
        bindtouchcancel="endCandidateDrag"
      >
        <view class="sheet__handle"></view>
      </view>
      <view class="candidate-sheet__head">
        <view>
          <text class="candidate-sheet__title">候选菜</text>
          <text class="candidate-sheet__count">共 {{candidateDishes.length}} 道</text>
        </view>
      </view>

      <scroll-view class="candidate-sheet__list" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}">
        <view wx:for="{{candidateDishes}}" wx:key="id" class="candidate-row">
          <image class="candidate-row__image" src="{{item.coverUrl}}" mode="aspectFill" />
          <view class="candidate-row__body">
            <text class="candidate-row__name">{{item.name}}</text>
            <text class="candidate-row__meta">{{item.category}}</text>
          </view>
          <button
            wx:if="{{meal.createdByMe && meal.status === 'collecting' && item.available}}"
            class="candidate-row__remove"
            data-id="{{item.id}}"
            loading="{{removingCandidateId === item.id}}"
            disabled="{{removingCandidateId || availableCandidateCount === 1}}"
            catchtap="requestRemoveCandidate"
          >{{availableCandidateCount === 1 ? "需保留" : "移除"}}</button>
        </view>
        <view wx:if="{{candidateDishes.length === 0}}" class="candidate-sheet__empty">暂无候选菜</view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{showCloseConfirm}}" class="sheet-mask" bindtap="closeCloseConfirm" catchtouchmove="noop">
    <view class="sheet close-confirm" catchtap="noop">
      <view class="sheet__handle"></view>
      <view class="close-confirm__icon">
        <app-icon name="circle-stop-solid" tone="danger" size="{{30}}" />
      </view>
      <text class="close-confirm__title">提前关闭点餐？</text>
      <text class="close-confirm__description">关闭后参与者不能新增或修改点餐，且无法重新开启。你仍可查看点菜结果并确认最终菜单。</text>

      <view class="close-confirm__meal">
        <view class="status-dot"></view>
        <view>
          <text class="close-confirm__meal-name">当前仍在收集中</text>
          <text class="close-confirm__meal-meta">原定 {{meal.deadlineLabel}} 自动关闭</text>
        </view>
      </view>

      <view class="close-confirm__actions">
        <button class="close-confirm__cancel" disabled="{{closing || cancelling}}" bindtap="closeCloseConfirm">继续收集</button>
        <button class="close-confirm__submit" loading="{{closing}}" disabled="{{closing || cancelling}}" bindtap="confirmCloseMeal">确认关闭</button>
      </view>
    </view>
  </view>
</view>
