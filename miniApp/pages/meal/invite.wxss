.invite-summary {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.invite-summary__name,
.invite-summary__meta {
  display: block;
}

.invite-summary__name {
  font-size: 36rpx;
  font-weight: 850;
}

.invite-summary__meta {
  margin-top: 8rpx;
  color: #7b8982;
  font-size: 23rpx;
}

.invite-summary .pill {
  gap: 8rpx;
}

.code-card {
  padding-top: 42rpx;
  text-align: center;
}

.code-card__label,
.code-card__code,
.code-card__deadline {
  display: block;
}

.code-card__label {
  color: #7b8982;
  font-size: 23rpx;
}

.code-card__code {
  margin-top: 18rpx;
  color: #159b55;
  font-size: 82rpx;
  font-weight: 850;
  letter-spacing: 12rpx;
}

.code-card__deadline {
  margin-top: 12rpx;
  color: #7b8982;
  font-size: 23rpx;
}

.code-card__actions {
  display: flex;
  gap: 16rpx;
  margin-top: 36rpx;
}

.code-card__actions .btn {
  flex: 1;
  height: 82rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
}

.invite-tip {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 32rpx 0;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #eef8f2;
}

.close-meal {
  display: flex;
  width: 100%;
  height: 84rpx;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  border: 2rpx solid #edaaa5;
  border-radius: 999rpx;
  color: #d8564f;
  font-size: 27rpx;
  font-weight: 800;
}

.close-meal__help {
  display: block;
  margin-top: 16rpx;
  color: #8a958f;
  font-size: 21rpx;
  text-align: center;
}
