.invite-page {
  padding-bottom: calc(286rpx + env(safe-area-inset-bottom));
  background: #f7faf7;
}

.invite-content {
  padding: 24rpx 20rpx 34rpx;
}

.invite-panel {
  border: 1rpx solid #e8eee9;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(16, 38, 26, 0.04);
}

.invite-summary {
  padding: 22rpx 24rpx;
}

.invite-summary__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.invite-summary__name {
  min-width: 0;
  overflow: hidden;
  font-size: 31rpx;
  font-weight: 850;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.invite-status {
  display: inline-flex;
  min-height: 44rpx;
  flex: none;
  align-items: center;
  gap: 8rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #e9f8ef;
  color: #159b55;
  font-size: 21rpx;
  font-weight: 750;
}

.invite-status--closed {
  background: #f0f3f1;
  color: #6f7b75;
}

.invite-status--closed .status-dot {
  background: #8f9a94;
}

.invite-summary__meta {
  display: flex;
  gap: 34rpx;
  margin-top: 20rpx;
}

.invite-summary__meta > view {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 9rpx;
  color: #7b8982;
  font-size: 21rpx;
}

.code-card {
  margin-top: 20rpx;
  padding: 34rpx 24rpx 30rpx;
}

.code-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.code-card__title,
.code-card__subtitle {
  display: block;
}

.code-card__title {
  color: #1b241f;
  font-size: 34rpx;
  font-weight: 850;
}

.code-card__subtitle {
  margin-top: 11rpx;
  color: #8a9690;
  font-size: 20rpx;
}

.code-card__availability {
  display: inline-flex;
  min-height: 44rpx;
  flex: none;
  align-items: center;
  gap: 7rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #eef8f2;
  color: #159b55;
  font-size: 20rpx;
  font-weight: 750;
}

.code-digits {
  display: grid;
  width: 92%;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 14rpx;
  margin: 34rpx auto 0;
}

.code-digit {
  display: flex;
  height: 108rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #dce7e0;
  border-radius: 13rpx;
  background: #f6faf7;
  color: #20352a;
  font-size: 40rpx;
  font-weight: 850;
}

.copy-code {
  display: flex;
  width: 304rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  gap: 11rpx;
  margin: 28rpx auto 0;
  border: 2rpx solid #9fd3b4;
  border-radius: 999rpx;
  color: #159b55;
  font-size: 24rpx;
  font-weight: 750;
}

.code-card__divider {
  height: 1rpx;
  margin: 30rpx 0 26rpx;
  background: #edf1ee;
}

.countdown-tip {
  display: flex;
  min-height: 124rpx;
  align-items: center;
  gap: 18rpx;
  margin-top: 0;
  padding: 22rpx 24rpx;
  border-radius: 14rpx;
  background: #eef8f2;
}

.countdown-tip__title,
.countdown-tip__meta {
  display: block;
}

.countdown-tip__title {
  color: #23362b;
  font-size: 24rpx;
  font-weight: 800;
}

.countdown-tip__meta {
  margin-top: 8rpx;
  color: #7a8981;
  font-size: 19rpx;
  line-height: 1.45;
}

.share-button {
  display: flex;
  width: 100%;
  height: 94rpx;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin-top: 26rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #20b866 0%, #0a8e52 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
}
.candidate-entry {
  display: flex;
  width: 100%;
  height: 88rpx;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 20rpx;
  padding: 0 24rpx;
  text-align: left;
}

.candidate-entry__title {
  color: #1b241f;
  font-size: 30rpx;
  font-weight: 850;
}

.candidate-entry__aside {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #159b55;
  font-size: 22rpx;
  font-weight: 750;
}

.candidate-sheet {
  padding-top: 18rpx;
  transition: transform 180ms ease-out;
}

.candidate-sheet--dragging {
  transition: none;
}

.candidate-sheet__drag-handle {
  display: flex;
  height: 44rpx;
  align-items: center;
  justify-content: center;
  margin: -8rpx 0 4rpx;
}

.candidate-sheet__drag-handle .sheet__handle {
  margin: 0;
}

.candidate-sheet__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.candidate-sheet__title,
.candidate-sheet__count {
  display: block;
}

.candidate-sheet__title {
  font-size: 36rpx;
  font-weight: 850;
}

.candidate-sheet__count {
  margin-top: 8rpx;
  color: #7b8982;
  font-size: 21rpx;
}

.candidate-sheet__list {
  height: 560rpx;
  max-height: 720rpx;
  margin-top: 24rpx;
}

.candidate-row {
  display: flex;
  min-height: 138rpx;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 2rpx;
  border-top: 1rpx solid #edf1ee;
}

.candidate-row__image {
  width: 106rpx;
  height: 106rpx;
  flex: none;
  border-radius: 12rpx;
  background: #eef3ef;
}

.candidate-row__body {
  min-width: 0;
  flex: 1;
}

.candidate-row__remove {
  flex: none;
  min-width: 92rpx;
  height: 56rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 1rpx solid rgba(216, 86, 79, 0.28);
  border-radius: 28rpx;
  background: #fff7f6;
  color: #c74b45;
  font-size: 24rpx;
  line-height: 54rpx;
}

.candidate-row__remove::after {
  border: 0;
}

.candidate-row__name,
.candidate-row__meta {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.candidate-row__name {
  color: #1b241f;
  font-size: 28rpx;
  font-weight: 800;
}

.candidate-row__meta {
  margin-top: 12rpx;
  color: #7b8982;
  font-size: 21rpx;
}

.candidate-sheet__empty {
  padding: 90rpx 0;
  color: #8a9690;
  font-size: 24rpx;
  text-align: center;
}

.invite-dock {
  padding: 24rpx 44rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 0;
  background: #fff;
  box-shadow: 0 -8rpx 24rpx rgba(16, 38, 26, 0.04);
}

.invite-dock .btn,
.close-meal {
  width: 100%;
  height: 96rpx;
}

.close-meal {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15rpx;
  border: 2rpx solid #e7a5a0;
  border-radius: 999rpx;
  color: #d8564f;
  font-size: 28rpx;
  font-weight: 800;
}

.invite-dock__help {
  display: block;
  margin-top: 18rpx;
  color: #929c96;
  font-size: 20rpx;
  text-align: center;
}

.cancel-meal {
  display: flex;
  min-height: 56rpx;
  align-items: center;
  justify-content: center;
  margin: 10rpx auto 0;
  color: #c84e48;
  font-size: 22rpx;
  font-weight: 750;
}

.cancel-meal[disabled] {
  opacity: 0.55;
}

.close-confirm {
  min-height: 820rpx;
  padding: 22rpx 44rpx calc(42rpx + env(safe-area-inset-bottom));
  border-radius: 40rpx 40rpx 0 0;
  text-align: center;
}

.close-confirm > .sheet__handle {
  margin-bottom: 34rpx;
}

.close-confirm__icon {
  display: flex;
  width: 100rpx;
  height: 100rpx;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  border-radius: 50%;
  background: #fff0ef;
}

.close-confirm__title,
.close-confirm__description {
  display: block;
}

.close-confirm__title {
  margin-top: 26rpx;
  color: #1b241f;
  font-size: 38rpx;
  font-weight: 850;
}

.close-confirm__description {
  max-width: 540rpx;
  margin: 18rpx auto 0;
  color: #75827b;
  font-size: 22rpx;
  line-height: 1.75;
}

.close-confirm__meal {
  display: flex;
  min-height: 118rpx;
  align-items: center;
  gap: 18rpx;
  margin-top: 34rpx;
  padding: 24rpx 26rpx;
  border-radius: 14rpx;
  background: #f7faf8;
  text-align: left;
}

.close-confirm__meal-name,
.close-confirm__meal-meta {
  display: block;
}

.close-confirm__meal-name {
  font-size: 24rpx;
  font-weight: 800;
}

.close-confirm__meal-meta {
  margin-top: 8rpx;
  color: #8a9690;
  font-size: 20rpx;
}

.close-confirm__actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 26rpx;
  margin-top: 34rpx;
}

.close-confirm__cancel,
.close-confirm__submit {
  display: flex;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
}

.close-confirm__cancel {
  background: #f1f4f2;
  color: #5d6a63;
}

.close-confirm__submit {
  background: #d8564f;
  color: #fff;
}
