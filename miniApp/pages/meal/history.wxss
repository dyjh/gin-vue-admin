.history-page {
  min-height: 100vh;
  background: #fff;
}

.history-overview {
  display: flex;
  min-height: 116rpx;
  align-items: center;
  justify-content: space-between;
  padding: 0 40rpx;
  border-bottom: 14rpx solid #f3f6f4;
  background: #fff;
}

.history-overview > view {
  display: flex;
  align-items: baseline;
  gap: 9rpx;
}

.history-overview__count {
  color: #159b55;
  font-size: 42rpx;
  font-weight: 850;
}

.history-overview__unit {
  color: #29372f;
  font-size: 25rpx;
  font-weight: 800;
}

.history-overview__hint {
  color: #7b8982;
  font-size: 21rpx;
}

.history-content {
  min-height: 720rpx;
  padding: 6rpx 0 calc(70rpx + env(safe-area-inset-bottom));
  background: #fff;
}

.history-group__label {
  display: block;
  padding: 30rpx 40rpx 10rpx;
  color: #55645c;
  font-size: 23rpx;
  font-weight: 800;
}

.history-group__list {
  padding: 0 40rpx;
}

.history-row {
  display: grid;
  width: 100%;
  min-height: 164rpx;
  grid-template-columns: 112rpx minmax(0, 1fr) 30rpx;
  align-items: center;
  gap: 20rpx;
  border-bottom: 1rpx solid #edf1ee;
  background: #fff;
  text-align: left;
}

.history-row--pressed {
  background: #f8fbf9;
}

.history-row__image {
  width: 112rpx;
  height: 96rpx;
  border-radius: 14rpx;
  background: #edf2ef;
}

.history-row__body {
  min-width: 0;
}

.history-row__title-line {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.history-row__title {
  overflow: hidden;
  color: #1b241f;
  font-size: 28rpx;
  font-weight: 850;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-row__status {
  flex: none;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #e9f8ef;
  color: #159b55;
  font-size: 18rpx;
  font-weight: 750;
}

.history-row__status--cancelled {
  background: #f0f3f1;
  color: #7b8982;
}

.history-row__date {
  display: block;
  margin-top: 9rpx;
  color: #7b8982;
  font-size: 21rpx;
}

.history-row__meta {
  display: flex;
  margin-top: 12rpx;
  align-items: center;
  gap: 24rpx;
}

.history-row__meta view {
  display: flex;
  align-items: center;
  gap: 7rpx;
  color: #607068;
  font-size: 20rpx;
}

.history-status {
  padding: 34rpx 0;
  color: #8a958f;
  font-size: 21rpx;
  text-align: center;
}

.history-loading {
  padding: 24rpx 40rpx;
}

.history-loading view {
  height: 126rpx;
  margin-bottom: 18rpx;
  border-radius: 12rpx;
  background: #f1f5f2;
}

.history-detail {
  max-height: 78vh;
  overflow-y: auto;
  padding-top: 18rpx;
}

.history-detail__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 2rpx 26rpx;
  border-bottom: 1rpx solid #edf1ee;
}

.history-detail__title,
.history-detail__date {
  display: block;
}

.history-detail__title {
  color: #1b241f;
  font-size: 34rpx;
  font-weight: 850;
}

.history-detail__date {
  margin-top: 10rpx;
  color: #7b8982;
  font-size: 22rpx;
}

.history-detail__status {
  flex: none;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #e9f8ef;
  color: #159b55;
  font-size: 20rpx;
  font-weight: 750;
}

.history-detail__summary {
  display: grid;
  margin: 24rpx 0 30rpx;
  grid-template-columns: repeat(3, 1fr);
  padding: 22rpx 0;
  border-radius: 18rpx;
  background: #f2faf5;
}

.history-detail__summary view {
  display: flex;
  align-items: center;
  flex-direction: column;
  border-right: 1rpx solid #dfece4;
}

.history-detail__summary view:last-child {
  border-right: 0;
}

.history-detail__summary text:first-child {
  color: #159b55;
  font-size: 32rpx;
  font-weight: 850;
}

.history-detail__summary text:last-child {
  margin-top: 8rpx;
  color: #718078;
  font-size: 20rpx;
}

.history-detail__section-title {
  display: block;
  margin-bottom: 12rpx;
  color: #1b241f;
  font-size: 28rpx;
  font-weight: 850;
}

.history-detail__dishes {
  max-height: 440rpx;
}

.history-dish {
  display: grid;
  min-height: 116rpx;
  grid-template-columns: 82rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 16rpx;
  border-bottom: 1rpx solid #edf1ee;
}

.history-dish image {
  width: 82rpx;
  height: 76rpx;
  border-radius: 12rpx;
}

.history-dish__name,
.history-dish__meta {
  display: block;
}

.history-dish__name {
  color: #26332c;
  font-size: 25rpx;
  font-weight: 800;
}

.history-dish__meta {
  margin-top: 7rpx;
  overflow: hidden;
  color: #849088;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-dish__servings {
  color: #159b55;
  font-size: 22rpx;
  font-weight: 800;
}

.history-detail__archive {
  display: flex;
  margin-top: 24rpx;
  align-items: flex-start;
  gap: 10rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #eef8f2;
  color: #607068;
  font-size: 20rpx;
  line-height: 1.45;
}

.history-detail__notice {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
  gap: 10rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #fff7e9;
  color: #806335;
  font-size: 21rpx;
  line-height: 1.5;
}

.history-detail__shopping {
  margin-top: 26rpx;
}

.history-shopping-item {
  display: grid;
  min-height: 74rpx;
  grid-template-columns: 34rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 10rpx;
  border-bottom: 1rpx solid #edf1ee;
  color: #34423a;
  font-size: 22rpx;
}

.history-shopping-item text:last-child {
  color: #718078;
}
