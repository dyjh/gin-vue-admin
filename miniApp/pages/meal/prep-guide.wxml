<view wx:if="{{prepFeature && meal}}" class="page prep-page">
  <app-hero
    image="/assets/images/meal-prep-cat-sequencing-v1.jpg"
    title="{{prepFeature.title}}"
    subtitle="{{prepFeature.description}}"
  />

  <view class="prep-stage">
    <view class="prep-meal-card">
      <view class="prep-meal-card__head">
        <text class="prep-meal-card__name">{{meal.name}}</text>
        <view class="prep-status"><view class="prep-status__dot"></view><text>菜单已确认</text></view>
      </view>
      <text class="prep-meal-card__meta">{{dishCount}} 道菜 · 共 {{totalServings}} 份 · {{meal.participantCount}} 人参与</text>
    </view>

    <block wx:if="{{!plan}}">
      <view class="prep-ready">
        <view class="prep-section-heading">
          <text class="prep-section-heading__title">{{prepFeature.actionText}}</text>
          <text class="prep-section-heading__subtitle">{{prepFeature.description}}</text>
        </view>

        <view class="prep-analysis">
          <view class="prep-analysis__summary">
            <view class="prep-analysis__icon"><app-icon name="sparkles" tone="green" size="{{21}}" /></view>
            <view>
              <text class="prep-analysis__title">本次将分析 {{dishCount}} 道菜</text>
              <text class="prep-analysis__caption">生成准备顺序和并行处理建议</text>
            </view>
          </view>
          <view class="prep-analysis__details">
            <view class="prep-analysis__row"><text>参考信息</text><text>完整做法步骤、菜谱备注、最终份数</text></view>
            <view class="prep-analysis__row"><text>数据用途</text><text>仅用于生成本次饭局备菜提醒</text></view>
            <view class="prep-analysis__row"><text>结果影响</text><text>不会修改菜单、份数或采购清单</text></view>
          </view>
        </view>

        <view class="prep-points">
          <view class="prep-points__item"><text class="prep-points__value">{{points}}</text><text class="prep-points__label">当前积分</text></view>
          <view class="prep-points__item prep-points__item--cost"><text class="prep-points__value">- {{cost}}</text><text class="prep-points__label">本次消耗</text></view>
          <view class="prep-points__item prep-points__item--remaining"><text class="prep-points__value">{{remainingPoints}}</text><text class="prep-points__label">生成后剩余</text></view>
          <text class="prep-points__hint">生成失败或超时将自动退还积分</text>
        </view>

        <view class="prep-menu">
          <text class="prep-menu__title">本次菜单</text>
          <view class="prep-menu__grid">
            <view class="prep-menu__item" wx:for="{{menuItems}}" wx:key="id">
              <view class="prep-menu__check"><app-icon name="check" tone="green" size="{{12}}" /></view>
              <view class="prep-menu__copy"><text class="prep-menu__name">{{item.name}}</text><text class="prep-menu__servings">{{item.finalServings}} 份</text></view>
            </view>
          </view>
        </view>
      </view>

      <view class="prep-action-band prep-action-band--ready">
        <view class="prep-action-band__summary"><text>本次生成消耗 {{cost}} 积分</text><text>当前 {{points}}</text></view>
        <button class="prep-primary-action" loading="{{generating}}" disabled="{{generating || !canGenerate}}" bindtap="generate">
          <app-icon wx:if="{{!generating}}" name="sparkles" tone="white" size="{{22}}" />
          <text>{{generating ? '正在生成' : prepFeature.actionText}}</text>
        </button>
        <text class="prep-action-band__caption">提醒仅作参考，可忽略或重新生成</text>
      </view>
    </block>

    <block wx:else>
      <view class="prep-result">
        <view class="prep-result__head">
          <text class="prep-result__title">{{ignored ? '已忽略的顺序' : '建议操作顺序'}}</text>
          <text class="prep-result__time">{{generatedAt}} 生成</text>
        </view>
        <view class="prep-result__guide {{ignored ? 'prep-result__guide--ignored' : ''}}">
          <app-icon name="chevron-right" tone="green" size="{{15}}" />
          <text>{{ignored ? '这份顺序不会再主动展示' : '按菜谱依赖排序，等待时穿插其他准备'}}</text>
        </view>

        <view class="prep-timeline {{ignored ? 'prep-timeline--ignored' : ''}}">
          <view class="prep-timeline__step prep-timeline__step--{{index + 1}}" wx:for="{{plan.steps}}" wx:key="id">
            <view class="prep-timeline__rail">
              <view class="prep-timeline__dot">{{index + 1}}</view>
              <view wx:if="{{index < plan.steps.length - 1}}" class="prep-timeline__line"></view>
            </view>
            <view class="prep-timeline__body">
              <text class="prep-timeline__title">{{item.title}}</text>
              <view class="prep-timeline__task prep-timeline__task--now"><text class="prep-timeline__tag">现在做</text><text class="prep-timeline__text">{{item.instruction}}</text></view>
              <view wx:if="{{item.parallelText}}" class="prep-timeline__task prep-timeline__task--parallel"><text class="prep-timeline__tag">同时做</text><text class="prep-timeline__text">{{item.parallelText}}</text></view>
              <view class="prep-timeline__done"><app-icon name="check" tone="gray" size="{{11}}" /><text>完成标志：{{item.completionHint}}</text></view>
            </view>
          </view>
        </view>

        <view class="prep-result__note">
          <app-icon name="check" tone="green" size="{{13}}" />
          <text>{{ignored ? '需要时可重新生成一份新顺序' : '仅重排原菜谱步骤，不新增食材或做法'}}</text>
        </view>
      </view>

      <view class="prep-action-band prep-action-band--result">
        <view wx:if="{{!ignored}}" class="prep-result-actions">
          <button class="prep-secondary-action" bindtap="ignore">忽略本次</button>
          <button class="prep-primary-action" bindtap="openRegenerate"><app-icon name="refresh" tone="white" size="{{21}}" /><text>重新生成</text></button>
        </view>
        <button wx:else class="prep-primary-action" bindtap="openRegenerate"><app-icon name="refresh" tone="white" size="{{21}}" /><text>重新生成提醒</text></button>
        <text class="prep-action-band__caption">重新生成将再次消耗 {{cost}} 积分</text>
      </view>
    </block>
  </view>

  <view wx:if="{{showRegenerate}}" class="sheet-mask" bindtap="closeRegenerate">
    <view class="sheet prep-regenerate-sheet" catchtap="noop">
      <view class="sheet__handle"></view>
      <view class="prep-regenerate__head">
        <view class="prep-regenerate__icon"><app-icon name="refresh" tone="green" size="{{21}}" /></view>
        <view><text class="prep-regenerate__title">重新生成备菜提醒？</text><text class="prep-regenerate__subtitle">新结果生成成功后将替换当前提醒</text></view>
      </view>
      <view class="prep-regenerate__points">
        <view><text>{{points}}</text><text>当前积分</text></view>
        <view class="prep-regenerate__cost"><text>- {{cost}}</text><text>本次消耗</text></view>
        <view class="prep-regenerate__remaining"><text>{{remainingPoints}}</text><text>生成后剩余</text></view>
      </view>
      <view class="prep-regenerate__refund"><text>生成失败或超时会自动退还积分</text><text>旧提醒在新结果成功前仍会保留</text></view>
      <view class="prep-regenerate__actions">
        <button class="prep-regenerate__cancel" disabled="{{generating}}" bindtap="closeRegenerate">取消</button>
        <button class="prep-regenerate__confirm" loading="{{generating}}" disabled="{{generating}}" bindtap="confirmRegenerate">{{generating ? '正在生成' : '消耗 ' + cost + ' 积分生成'}}</button>
      </view>
    </view>
  </view>
</view>
