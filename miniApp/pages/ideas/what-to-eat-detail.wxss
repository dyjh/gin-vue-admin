.source-badge {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 18rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #e9f8ef;
  color: #159b55;
  font-size: 23rpx;
  font-weight: 800;
}

.suggestion-detail__cover {
  height: 360rpx;
}

.suggestion-detail__name {
  display: block;
  margin-top: 20rpx;
  font-size: 42rpx;
  font-weight: 850;
}

.suggestion-detail__meta {
  display: block;
  margin-top: 8rpx;
  color: #7b8982;
  font-size: 25rpx;
}

.suggestion-detail__tags {
  margin-top: 18rpx;
}

.suggestion-detail__description {
  display: block;
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #edf1ee;
  color: #526159;
  font-size: 25rpx;
  line-height: 1.7;
}

.suggestion-step {
  display: flex;
  gap: 18rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #edf1ee;
}

.suggestion-step__number {
  display: flex;
  width: 42rpx;
  height: 42rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #159b55;
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
}

.suggestion-step__body {
  min-width: 0;
  flex: 1;
  color: #3a4740;
  font-size: 26rpx;
  line-height: 1.65;
}

.suggestion-step__body image {
  width: 100%;
  height: 300rpx;
  margin-top: 18rpx;
  border-radius: 18rpx;
}

.consistency-note {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #eef8f2;
  color: #526159;
  font-size: 23rpx;
  line-height: 1.55;
}
