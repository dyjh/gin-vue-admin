<wxs module="array" src="../../wxs/array.wxs" />
<view wx:if="{{recipe}}" class="page">
  <app-hero
    image="/assets/images/recipe-detail-cat-bookmark-v3.jpg"
    title="菜谱详情"
    subtitle="整理菜谱，可直接创建饭局"
  />
  <view class="content">
    <view class="recipe-header">
      <button class="recipe-header__title" bindtap="editName">
        <text>{{recipe.name}}</text>
        <app-icon name="edit" tone="green" size="{{17}}" />
      </button>
      <view class="recipe-summary">
        <view class="recipe-summary__head">
          <text>简介</text>
          <text>选填</text>
        </view>
        <textarea
          class="recipe-header__note"
          auto-height="{{true}}"
          maxlength="100"
          value="{{recipe.note}}"
          placeholder="补充这份菜谱的适用场景、口味或搭配说明"
          bindinput="editNote"
          bindblur="saveNote"
        />
      </view>
      <text class="recipe-header__count">共 {{recipe.dishCount}} 道菜</text>
    </view>

    <section-head title="菜品" subtitle="左滑可移除，点击可查看详情" action="添加菜品" bind:action="openAdd" />
    <view class="recipe-dishes">
      <view class="swipe-row" wx:for="{{recipe.dishes}}" wx:key="id">
        <button
          class="swipe-row__delete {{swipeId === item.id ? 'swipe-row__delete--visible' : ''}}"
          data-id="{{item.id}}"
          bindtap="removeDish"
        >移除</button>
        <view
          class="swipe-row__content {{swipeId === item.id ? 'swipe-row__content--open' : ''}}"
          data-id="{{item.id}}"
          bindtouchstart="touchStart"
          bindtouchend="touchEnd"
          bindtap="openDish"
        >
          <image src="{{item.coverUrl}}" mode="aspectFill" />
          <view class="swipe-row__body">
            <text class="row__title">{{item.name}}</text>
            <view class="swipe-row__details">
              <text class="row__meta">{{item.category}} · 适合 {{item.serving}} 人</text>
              <text wx:if="{{item.tags && item.tags.length}}" class="pill">{{item.tags[0]}}</text>
            </view>
          </view>
          <app-icon name="chevron-right" tone="gray" size="{{17}}" />
        </view>
      </view>
      <empty-state wx:if="{{!recipe.dishes.length}}" icon="dish" title="菜谱里还没有菜" description="从已经编辑好的个人菜品中选择。" action="添加菜品" bind:action="openAdd" />
    </view>

    <view class="recipe-actions">
      <button class="btn btn--primary" bindtap="useForMeal"><app-icon name="calendar" tone="white" size="{{19}}" /><text>用于饭局选菜</text></button>
      <button class="btn btn--danger" bindtap="removeRecipe"><app-icon name="trash" tone="danger" size="{{19}}" /><text>删除菜谱</text></button>
    </view>
    <text class="recipe-actions__help">删除菜谱不会删除菜品库里的菜</text>
  </view>


  <view wx:if="{{showAdd}}" class="sheet-mask" bindtap="closeAdd">
    <view class="sheet add-sheet" catchtap="noop">
      <view class="sheet__handle"></view>
      <section-head title="添加菜品" subtitle="从已编辑好的菜品中选择" />
      <view class="add-filter">
        <view class="add-filter__search">
          <app-icon name="search" tone="gray" size="{{17}}" />
          <input value="{{dishFilterQuery}}" placeholder="搜索菜名、分类或标签" bindinput="inputDishFilter" />
          <button wx:if="{{dishFilterQuery}}" class="add-filter__clear" bindtap="clearDishFilter">清除</button>
        </view>
        <scroll-view class="add-filter__categories" scroll-x enhanced show-scrollbar="{{false}}">
          <button
            wx:for="{{dishCategories}}"
            wx:key="*this"
            class="add-filter__category {{dishFilterCategory === item ? 'add-filter__category--active' : ''}}"
            data-category="{{item}}"
            bindtap="selectDishCategory"
          >{{item}}</button>
        </scroll-view>
        <view class="add-filter__summary">
          <text>找到 {{filteredDishes.length}} 道</text>
          <text>已选 {{selectedIds.length}} 道</text>
        </view>
      </view>
      <view class="add-sheet__list">
        <dish-row
          wx:for="{{filteredDishes}}"
          wx:key="id"
          dish="{{item}}"
          action="select"
          selected="{{array.includes(selectedIds, item.id)}}"
          compact="{{true}}"
          bind:action="toggleDish"
        />
        <empty-state
          wx:if="{{!filteredDishes.length}}"
          icon="search"
          title="没有符合条件的菜品"
          description="换个关键词或分类试试。"
        />
      </view>
      <button class="btn btn--primary" bindtap="saveDishes">保存所选菜品（{{selectedIds.length}}）</button>
    </view>
  </view>
</view>
