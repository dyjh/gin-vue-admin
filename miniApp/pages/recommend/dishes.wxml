<view class="page">
  <app-hero
    image="/assets/images/recommended-dishes-cat-flag.jpg"
    title="菜品推荐"
    subtitle="官方与用户精选家常菜"
  />
  <view class="content recommendation-list">
    <scroll-view class="category-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
      <button
        wx:for="{{categories}}"
        wx:key="*this"
        class="tag {{category === item ? 'tag--selected' : 'tag--outline'}}"
        data-value="{{item}}"
        bindtap="selectCategory"
      >{{item}}</button>
    </scroll-view>
    <view class="card recommendation-list__card">
      <dish-row wx:for="{{list}}" wx:key="id" dish="{{item}}" bind:open="open" />
      <view wx:if="{{loading}}" class="loading-text">正在加载...</view>
      <view wx:elif="{{list.length >= total}}" class="loading-text">已经看到全部推荐</view>
    </view>
  </view>
</view>
