<view wx:if="{{meal}}" class="page shopping-page">
  <app-hero
    image="/assets/images/shopping-list-cat-packing-v1.jpg"
    title="采购清单"
    subtitle="按菜单汇总食材，买好逐项勾选"
  />
  <view class="shopping-summary">
    <view class="shopping-summary__head">
      <view><text class="shopping-summary__name">{{meal.name}}</text><text class="shopping-summary__meta">{{meal.finalDishCount}} 道菜 · {{items.length}} 项食材</text></view>
      <text class="pill"><view class="status-dot"></view><text>饭局进行中</text></text>
    </view>
    <view class="shopping-progress">
      <view><text>采购进度</text><text>已买 {{completedCount}} / {{items.length}}</text></view>
      <view class="shopping-progress__track"><view style="width: {{items.length ? completedCount / items.length * 100 : 0}}%;"></view></view>
    </view>
    <view class="shopping-tools">
      <button bindtap="copy"><app-icon name="copy" tone="green" size="{{18}}" /><text>复制清单</text></button>
      <button open-type="share" disabled="{{!shareToken}}"><app-icon name="share" tone="green" size="{{18}}" /><text>分享清单</text></button>
      <button wx:if="{{prepFeature}}" bindtap="openPrep"><app-icon name="sparkles" tone="green" size="{{18}}" /><text>{{prepFeature.actionText}}</text></button>
    </view>
  </view>

  <view class="shopping-content">
    <view class="segmented shopping-tabs">
      <button class="segmented__item {{scope === 'pending' ? 'segmented__item--active' : ''}}" data-scope="pending" bindtap="setScope">待购买 {{pendingCount}}</button>
      <button class="segmented__item {{scope === 'completed' ? 'segmented__item--active' : ''}}" data-scope="completed" bindtap="setScope">已购买 {{completedCount}}</button>
    </view>
    <view class="shopping-list">
      <block wx:for="{{items}}" wx:key="id">
        <view wx:if="{{scope === 'pending' ? !item.completed : item.completed}}" class="shopping-row">
          <button class="shopping-row__check {{item.completed ? 'shopping-row__check--checked' : ''}}" data-id="{{item.id}}" bindtap="toggle">
            <app-icon wx:if="{{item.completed}}" name="check" tone="white" size="{{10}}" />
          </button>
          <button class="shopping-row__body" data-id="{{item.id}}" bindtap="openEdit">
            <text class="shopping-row__name {{item.completed ? 'shopping-row__name--done' : ''}}">{{item.name}}</text>
            <text class="shopping-row__note">{{item.note}}</text>
          </button>
          <text class="shopping-row__amount">{{item.amount}}</text>
          <button class="shopping-row__edit" data-id="{{item.id}}" bindtap="openEdit" aria-label="编辑采购项"><app-icon name="edit" tone="gray" size="{{17}}" /></button>
        </view>
      </block>
      <empty-state
        wx:if="{{scope === 'pending' ? pendingCount === 0 : completedCount === 0}}"
        icon="cart"
        title="{{scope === 'pending' ? '待购买已经清空' : '还没有买好的项目'}}"
        description="{{scope === 'pending' ? '采购完成后，可以继续查看已购买项目。' : '勾选待购买项目后会显示在这里。'}}"
      />
    </view>
    <view wx:if="{{scope === 'completed' ? completedCount > 0 : false}}" class="shopping-completed-tip">
      <view class="shopping-completed-tip__icon">
        <app-icon name="check" tone="green" size="{{11}}" />
      </view>
      <view class="shopping-completed-tip__copy">
        <text class="shopping-completed-tip__title">这些已经买好啦</text>
        <text class="shopping-completed-tip__desc">误勾时可再次点击恢复为待购买</text>
      </view>
    </view>
    <view wx:if="{{meal.status === 'confirmed' && meal.createdByMe}}" class="meal-completion">
      <view class="meal-completion__copy">
        <text class="meal-completion__title">采购阶段仍属于本场饭局</text>
        <text class="meal-completion__desc">买菜、做饭都完成后，再手动结束饭局。结束后才能创建下一场。</text>
      </view>
      <button
        class="meal-completion__button"
        loading="{{finishing}}"
        disabled="{{finishing}}"
        bindtap="openCompleteConfirm"
      >结束这场饭局</button>
    </view>
  </view>
  <view class="bottom-dock">
    <button class="btn btn--primary" bindtap="openAdd"><app-icon name="plus" tone="white" size="{{20}}" /><text>新增采购项</text></button>
  </view>

  <view wx:if="{{showEditor}}" class="sheet-mask" bindtap="closeEditor">
    <view class="sheet shopping-editor-sheet" catchtap="noop">
      <view class="sheet__handle"></view>
      <view class="shopping-editor__header">
        <text class="shopping-editor__title">{{editingId ? '编辑采购项' : '新增采购项'}}</text>
        <button class="shopping-editor__close" bindtap="closeEditor" aria-label="关闭">
          <app-icon name="close" tone="gray" size="{{14}}" />
        </button>
      </view>
      <view class="field shopping-editor__field">
        <text class="field__label">食材名称</text>
        <input class="field__control" value="{{form.name}}" data-field="name" placeholder="例如：小葱" bindinput="inputField" />
      </view>
      <view class="shopping-editor__grid">
        <view class="field shopping-editor__field">
          <text class="field__label">数量</text>
          <input class="field__control" type="digit" value="{{form.quantity}}" data-field="quantity" placeholder="请输入" bindinput="inputField" />
        </view>
        <view class="field shopping-editor__field">
          <text class="field__label">单位</text>
          <picker mode="selector" range="{{unitOptions}}" value="{{unitIndex}}" bindchange="selectUnit">
            <view class="field__control shopping-editor__select {{form.unit ? '' : 'shopping-editor__select--placeholder'}}">{{form.unit || '请选择'}}</view>
          </picker>
        </view>
      </view>
      <view class="field shopping-editor__field">
        <text class="field__label">备注（选填）</text>
        <textarea class="field__control shopping-editor__note" value="{{form.note}}" data-field="note" maxlength="100" placeholder="补充品牌、规格或其他要求" bindinput="inputField" />
      </view>
      <button wx:if="{{editingId}}" class="delete-item" bindtap="removeItem"><app-icon name="trash" tone="danger" size="{{18}}" /><text>删除采购项</text></button>
      <view class="shopping-editor__actions {{editingId ? 'shopping-editor__actions--editing' : ''}}">
        <button class="shopping-editor__cancel" bindtap="closeEditor">取消</button>
        <button class="shopping-editor__submit" bindtap="saveItem">{{editingId ? '保存修改' : '添加到清单'}}</button>
      </view>
    </view>
  </view>
</view>
<view wx:elif="{{!loading}}" class="page shopping-page">
  <app-hero
    image="/assets/images/shopping-list-cat-packing-v1.jpg"
    title="采购清单"
    subtitle="确认最终菜单后，会自动生成采购清单"
  />
  <view class="shopping-content">
    <empty-state
      icon="cart"
      title="还没有当前采购清单"
      description="创建饭局并确认最终菜单后，再来这里查看和勾选采购项。"
      action="返回首页"
      bind:action="home"
    />
  </view>
</view>
