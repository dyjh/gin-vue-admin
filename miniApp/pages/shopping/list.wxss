.shopping-page {
  background: #fff;
}

.shopping-summary {
  padding: 28rpx 32rpx 24rpx;
  border-bottom: 12rpx solid #f3f6f4;
}

.shopping-summary__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.shopping-summary__name,
.shopping-summary__meta {
  display: block;
}

.shopping-summary__name {
  font-size: 34rpx;
  font-weight: 850;
}

.shopping-summary__meta {
  margin-top: 8rpx;
  color: #7b8982;
  font-size: 22rpx;
}

.shopping-summary__head .pill {
  gap: 8rpx;
  font-size: 20rpx;
}

.shopping-progress {
  margin-top: 24rpx;
}

.shopping-progress > view:first-child {
  display: flex;
  justify-content: space-between;
  color: #526159;
  font-size: 22rpx;
  font-weight: 750;
}

.shopping-progress__track {
  height: 12rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e7eee9;
}

.shopping-progress__track view {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #20b866, #0a8e52);
}

.shopping-tools {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-top: 24rpx;
  border-top: 1rpx solid #edf1ee;
}

.shopping-tools button {
  display: flex;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  border-right: 1rpx solid #edf1ee;
  color: #159b55;
  font-size: 22rpx;
  font-weight: 750;
}

.shopping-tools button:last-child {
  border-right: 0;
}

.shopping-content {
  padding: 24rpx 32rpx 170rpx;
}

.shopping-tabs {
  margin-bottom: 14rpx;
}

.shopping-row {
  display: grid;
  min-height: 112rpx;
  grid-template-columns: 48rpx minmax(0, 1fr) auto 44rpx;
  align-items: center;
  gap: 14rpx;
  border-bottom: 1rpx solid #edf1ee;
}

.shopping-row__check {
  display: flex;
  width: 40rpx;
  height: 40rpx;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #22b66a;
  border-radius: 50%;
}

.shopping-row__check--checked {
  border-color: #20b866;
  background: #20b866;
}

.shopping-row__body {
  min-width: 0;
  text-align: left;
}

.shopping-row__name,
.shopping-row__note {
  display: block;
}

.shopping-row__name {
  font-size: 28rpx;
  font-weight: 800;
}

.shopping-row__name--done {
  color: #8a958f;
  text-decoration: line-through;
}

.shopping-row__note {
  margin-top: 6rpx;
  overflow: hidden;
  color: #8a958f;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shopping-row__amount {
  color: #3a4740;
  font-size: 23rpx;
  font-weight: 750;
}

.shopping-row__edit {
  display: flex;
  width: 44rpx;
  height: 44rpx;
  align-items: center;
  justify-content: center;
}

.delete-item {
  display: flex;
  width: 100%;
  height: 74rpx;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin: 6rpx 0 20rpx;
  color: #d8564f;
  font-size: 25rpx;
  font-weight: 750;
}
