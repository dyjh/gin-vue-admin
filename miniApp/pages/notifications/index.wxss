.notifications-page {
  background: #fff;
}

.notification-head {
  display: flex;
  height: 122rpx;
  align-items: center;
  justify-content: space-between;
  padding: 0 43rpx;
  background: #fff;
}

.notification-head__title {
  color: #24342c;
  font-size: 27rpx;
  font-weight: 800;
}

.mark-read {
  display: flex;
  min-width: 136rpx;
  height: 64rpx;
  align-items: center;
  justify-content: flex-end;
  background: transparent;
  color: #159b55;
  font-size: 21rpx;
  font-weight: 700;
}

.mark-read[disabled] {
  background: transparent;
  color: #a2aaa6;
}

.notification-tabs {
  position: sticky;
  z-index: 10;
  top: 0;
  display: grid;
  height: 97rpx;
  grid-template-columns: repeat(2, 1fr);
  border-bottom: 1rpx solid #eef1ee;
  background: #fff;
}

.notification-tabs button {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7b8982;
  font-size: 23rpx;
  font-weight: 500;
}

.notification-tabs button.active {
  color: #159b55;
  font-weight: 800;
}

.notification-tab__indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 66rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: #16b96f;
  transform: translateX(-50%);
}

.notification-list {
  min-height: 700rpx;
  padding-bottom: calc(86rpx + env(safe-area-inset-bottom));
  background: #fff;
}

.notification-group__label {
  display: block;
  padding: 28rpx 43rpx 8rpx;
  color: #66736c;
  font-size: 20rpx;
  font-weight: 700;
}

.notification-row {
  position: relative;
  display: grid;
  width: 100%;
  min-height: 172rpx;
  grid-template-columns: 68rpx minmax(0, 1fr);
  align-items: center;
  gap: 20rpx;
  padding: 0 43rpx 0 45rpx;
  background: #fff;
  text-align: left;
}

.notification-row--pressed {
  background: #f8fbf9;
}

.notification-row__icon {
  display: flex;
  width: 68rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #eaf7ef;
}

.notification-row__icon--refund {
  background: #eef7fa;
}

.notification-row__icon--governance,
.notification-row__icon--discover {
  background: #fff1ef;
}

.notification-row__icon--points {
  background: #fff5e7;
}

.notification-row--read .notification-row__icon {
  opacity: 0.66;
}

.notification-row__body {
  min-width: 0;
}

.notification-row__title-line {
  display: flex;
  min-width: 0;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
}

.notification-row__title {
  overflow: hidden;
  color: #24342c;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notification-row__dot {
  position: absolute;
  top: 48rpx;
  left: 28rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #16b96f;
}

.notification-row__content {
  display: block;
  margin-top: 9rpx;
  overflow: hidden;
  color: #526159;
  font-size: 20rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notification-row__detail {
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  color: #8a9690;
  font-size: 18rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notification-row__time {
  flex: none;
  color: #9aa49e;
  font-size: 18rpx;
  font-weight: 400;
}

.notification-row--read .notification-row__title {
  color: #56645d;
  font-weight: 650;
}

.notification-row--read .notification-row__content {
  color: #7b8982;
}

.notification-row__divider {
  position: absolute;
  right: 29rpx;
  bottom: 0;
  left: 133rpx;
  height: 1rpx;
  background: #eef1ee;
}

.list-status {
  padding: 50rpx 0;
  color: #8a958f;
  font-size: 22rpx;
  text-align: center;
}

.list-status--more {
  padding: 22rpx 0;
}

.notification-empty {
  display: flex;
  padding-top: 236rpx;
  align-items: center;
  flex-direction: column;
}

.notification-empty__icon {
  display: flex;
  width: 122rpx;
  height: 122rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #eaf7ef;
}

.notification-empty__title,
.notification-empty__description {
  display: block;
  text-align: center;
}

.notification-empty__title {
  margin-top: 40rpx;
  color: #35443c;
  font-size: 27rpx;
  font-weight: 800;
}

.notification-empty__description {
  margin-top: 16rpx;
  color: #8a9690;
  font-size: 20rpx;
}
