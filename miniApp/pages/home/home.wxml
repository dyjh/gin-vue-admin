<view class="home-page page-shell">
  <scroll-view class="home-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="hero-card">
      <view class="hero-copy">
        <text class="hero-kicker">来干饭</text>
        <text class="hero-title">把家里的拿手菜管起来</text>
        <text class="hero-desc">先维护自己的菜品库，饭局点菜和采购清单都会更顺手。</text>
      </view>

      <view class="hero-doodle dot-a"></view>
      <view class="hero-doodle dot-b"></view>
      <view class="hero-doodle leaf-a"></view>
      <view class="hero-doodle leaf-b"></view>

      <view class="cat-scene">
        <view class="steam steam-a"></view>
        <view class="steam steam-b"></view>
        <view class="pan">
          <view class="pan-handle"></view>
          <view class="pan-food food-a"></view>
          <view class="pan-food food-b"></view>
          <view class="pan-food food-c"></view>
        </view>
        <view class="cat-ear ear-left"></view>
        <view class="cat-ear ear-right"></view>
        <view class="cat-head">
          <view class="cat-eye eye-left"></view>
          <view class="cat-eye eye-right"></view>
          <view class="cat-nose"></view>
          <view class="cat-mouth"></view>
        </view>
        <view class="cat-body">
          <view class="apron">
            <view class="apron-pocket"></view>
          </view>
        </view>
      </view>
    </view>

    <view class="search-row">
      <view class="search-box" bindtap="onSearchTap">
        <view class="search-icon"></view>
        <text>搜索菜品、分类或口味</text>
      </view>
      <button class="add-button" bindtap="onAddDish" hover-class="button-hover">+</button>
    </view>

    <view class="quick-card">
      <text class="quick-title">今天先做哪一步？</text>
      <view class="quick-actions">
        <button class="quick-action" bindtap="onAddDish" hover-class="button-hover">手动录入</button>
        <button class="quick-action light" bindtap="onAddDish" hover-class="button-hover">AI 补全</button>
        <button class="quick-action light" bindtap="goProfile" hover-class="button-hover">创建饭局</button>
      </view>
    </view>

    <view class="section">
      <view class="section-header">
        <view>
          <text class="section-title">我的菜品</text>
          <text class="section-subtitle">最多展示三行，更多内容进全部菜品查看</text>
        </view>
        <button class="text-link" bindtap="onViewAllDishes" hover-class="link-hover">查看全部</button>
      </view>

      <scroll-view class="category-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="category-list">
          <button
            wx:for="{{categories}}"
            wx:key="*this"
            class="category-chip {{activeCategory == item ? 'active' : ''}}"
            data-name="{{item}}"
            bindtap="onCategoryTap"
            hover-class="chip-hover"
          >{{item}}</button>
        </view>
      </scroll-view>

      <view class="my-dish-grid">
        <view class="dish-card" wx:for="{{myDishes}}" wx:key="id">
          <view class="dish-cover">
            <text>{{item.mark}}</text>
          </view>
          <view class="dish-info">
            <text class="dish-name">{{item.name}}</text>
            <text class="dish-meta">{{item.meta}}</text>
            <view class="dish-tags">
              <text wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="section recommend-section">
      <view class="section-header">
        <view>
          <text class="section-title">菜品推荐</text>
          <text class="section-subtitle">展示 5 个精选菜品，可继续下翻</text>
        </view>
        <button class="text-link" bindtap="onViewAllRecommended" hover-class="link-hover">查看更多</button>
      </view>

      <view class="recommend-list">
        <view class="recommend-card" wx:for="{{recommendations}}" wx:key="id">
          <view class="recommend-cover">
            <text>{{item.mark}}</text>
          </view>
          <view class="recommend-main">
            <view class="recommend-topline">
              <text class="recommend-name">{{item.name}}</text>
              <text class="recommend-reason">{{item.reason}}</text>
            </view>
            <text class="recommend-desc">{{item.desc}}</text>
            <view class="recommend-bottom">
              <view class="recommend-tags">
                <text wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
              </view>
              <button
                class="recommend-action"
                data-name="{{item.name}}"
                bindtap="onAddRecommendedDish"
                hover-class="button-hover"
              >加入菜品库</button>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="ai-dock">
    <button class="ai-button" bindtap="onAskAI" hover-class="button-hover">
      <view class="ai-mark">AI</view>
      <view class="ai-copy">
        <text class="ai-title">不知道吃什么</text>
        <text class="ai-desc">按你的菜品库和口味帮你挑</text>
      </view>
      <text class="ai-arrow">›</text>
    </button>
  </view>

  <view class="custom-tabbar">
    <view class="tab-item active">
      <view class="tab-icon home"></view>
      <text>首页</text>
    </view>
    <view class="tab-item" bindtap="goRecipes">
      <view class="tab-icon recipe"></view>
      <text>菜谱</text>
    </view>
    <view class="tab-item" bindtap="goProfile">
      <view class="tab-icon mine"></view>
      <text>我的</text>
    </view>
  </view>
</view>
