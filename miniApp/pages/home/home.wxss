.home-page {
  position: relative;
  overflow: hidden;
}

.home-scroll {
  height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(244rpx + env(safe-area-inset-bottom));
}

.hero-card {
  position: relative;
  height: 330rpx;
  margin: 22rpx 24rpx 0;
  overflow: hidden;
  border-radius: 0 0 40rpx 40rpx;
  background: linear-gradient(135deg, #e9f8c9 0%, #d4f3cc 46%, #fff0b7 100%);
  box-shadow: 0 22rpx 40rpx rgba(48, 103, 68, 0.12);
}

.hero-card::before {
  content: "";
  position: absolute;
  top: -80rpx;
  right: -120rpx;
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.42);
}

.hero-copy {
  position: relative;
  z-index: 2;
  width: 390rpx;
  padding: 48rpx 0 0 38rpx;
  display: flex;
  flex-direction: column;
}

.hero-kicker {
  align-self: flex-start;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  color: #117846;
  background: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.2;
}

.hero-title {
  margin-top: 22rpx;
  color: #18312a;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.18;
}

.hero-desc {
  margin-top: 14rpx;
  color: rgba(24, 49, 42, 0.7);
  font-size: 25rpx;
  line-height: 1.55;
}

.hero-doodle {
  position: absolute;
  z-index: 1;
}

.dot-a {
  top: 36rpx;
  left: 450rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #ffb45f;
}

.dot-b {
  top: 244rpx;
  left: 330rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #49c985;
}

.leaf-a,
.leaf-b {
  width: 44rpx;
  height: 20rpx;
  border-radius: 44rpx 44rpx 6rpx 44rpx;
  background: rgba(22, 158, 89, 0.28);
}

.leaf-a {
  top: 70rpx;
  right: 230rpx;
  transform: rotate(-28deg);
}

.leaf-b {
  right: 36rpx;
  bottom: 34rpx;
  transform: rotate(20deg);
}

.cat-scene {
  position: absolute;
  right: 4rpx;
  bottom: 0;
  z-index: 2;
  width: 300rpx;
  height: 270rpx;
}

.cat-head {
  position: absolute;
  right: 56rpx;
  top: 58rpx;
  width: 142rpx;
  height: 126rpx;
  border-radius: 64rpx 64rpx 56rpx 56rpx;
  background: #fff4d5;
  border: 6rpx solid #5d6a45;
  box-sizing: border-box;
}

.cat-ear {
  position: absolute;
  top: 34rpx;
  width: 56rpx;
  height: 56rpx;
  background: #fff4d5;
  border: 6rpx solid #5d6a45;
  border-radius: 12rpx;
  transform: rotate(45deg);
  box-sizing: border-box;
}

.ear-left {
  right: 166rpx;
}

.ear-right {
  right: 58rpx;
}

.cat-eye {
  position: absolute;
  top: 48rpx;
  width: 12rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: #283832;
}

.eye-left {
  left: 38rpx;
}

.eye-right {
  right: 38rpx;
}

.cat-nose {
  position: absolute;
  top: 68rpx;
  left: 62rpx;
  width: 16rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ef8b82;
}

.cat-mouth {
  position: absolute;
  top: 82rpx;
  left: 54rpx;
  width: 34rpx;
  height: 16rpx;
  border-bottom: 4rpx solid #566244;
  border-radius: 0 0 28rpx 28rpx;
}

.cat-body {
  position: absolute;
  right: 64rpx;
  bottom: 24rpx;
  width: 128rpx;
  height: 116rpx;
  border-radius: 58rpx 58rpx 30rpx 30rpx;
  background: #fff4d5;
  border: 6rpx solid #5d6a45;
  box-sizing: border-box;
}

.apron {
  position: absolute;
  right: 24rpx;
  bottom: 0;
  left: 24rpx;
  height: 82rpx;
  border-radius: 24rpx 24rpx 18rpx 18rpx;
  background: #61d08f;
}

.apron-pocket {
  position: absolute;
  bottom: 16rpx;
  left: 22rpx;
  width: 36rpx;
  height: 22rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.76);
  border-top: 0;
  border-radius: 0 0 12rpx 12rpx;
}

.pan {
  position: absolute;
  left: 18rpx;
  bottom: 30rpx;
  width: 112rpx;
  height: 58rpx;
  border-radius: 0 0 58rpx 58rpx;
  background: #38433e;
  transform: rotate(-8deg);
}

.pan::before {
  content: "";
  position: absolute;
  top: -12rpx;
  left: 8rpx;
  width: 94rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #5b6760;
}

.pan-handle {
  position: absolute;
  top: 8rpx;
  left: -70rpx;
  width: 82rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: #38433e;
}

.pan-food {
  position: absolute;
  z-index: 2;
  top: -18rpx;
  border-radius: 50%;
}

.food-a {
  left: 24rpx;
  width: 22rpx;
  height: 22rpx;
  background: #ff8f65;
}

.food-b {
  left: 52rpx;
  width: 18rpx;
  height: 18rpx;
  background: #ffd45c;
}

.food-c {
  left: 74rpx;
  width: 20rpx;
  height: 20rpx;
  background: #44b978;
}

.steam {
  position: absolute;
  top: 6rpx;
  width: 24rpx;
  height: 52rpx;
  border-left: 6rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 50%;
}

.steam-a {
  left: 62rpx;
  transform: rotate(18deg);
}

.steam-b {
  left: 104rpx;
  transform: rotate(-16deg);
}

.search-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 24rpx 0;
}

.search-box {
  flex: 1;
  height: 76rpx;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-sizing: border-box;
  color: #8d9b96;
  font-size: 27rpx;
  background: #ffffff;
  border-radius: 999rpx;
  box-shadow: 0 12rpx 34rpx rgba(36, 80, 62, 0.08);
}

.search-icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid #aab7b1;
  border-radius: 50%;
  box-sizing: border-box;
}

.search-icon::after {
  content: "";
  position: absolute;
  right: -9rpx;
  bottom: -7rpx;
  width: 14rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #aab7b1;
  transform: rotate(45deg);
}

.add-button {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #16c875;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 72rpx;
  box-shadow: 0 12rpx 24rpx rgba(16, 185, 105, 0.24);
}

.button-hover {
  opacity: 0.82;
}

.quick-card,
.section {
  margin: 24rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 14rpx 34rpx rgba(36, 80, 62, 0.07);
}

.quick-title {
  display: block;
  color: #244139;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.25;
}

.quick-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.quick-action {
  flex: 1;
  height: 66rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #15bd70;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 66rpx;
}

.quick-action.light {
  color: #168457;
  background: #eaf8ee;
}

.section {
  padding-bottom: 30rpx;
}

.section-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.section-title,
.section-subtitle {
  display: block;
}

.section-title {
  color: #1d352e;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.2;
}

.section-subtitle {
  margin-top: 10rpx;
  color: #82908b;
  font-size: 23rpx;
  line-height: 1.35;
}

.text-link {
  flex: none;
  padding: 8rpx 0 8rpx 18rpx;
  color: #12a965;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.2;
}

.link-hover {
  color: #0d8b53;
}

.category-scroll {
  width: 100%;
  margin-top: 24rpx;
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  gap: 14rpx;
}

.category-chip {
  min-width: 92rpx;
  height: 54rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  color: #71817b;
  background: #f4f7f2;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 54rpx;
}

.category-chip.active {
  color: #ffffff;
  background: #18bd72;
}

.chip-hover {
  background: #e8f5ec;
}

.my-dish-grid {`r`n  max-height: 624rpx;`r`n  margin-top: 22rpx;`r`n  overflow: hidden;`r`n  display: flex;`r`n  flex-wrap: wrap;`r`n  margin-right: -16rpx;`r`n  margin-bottom: -16rpx;`r`n}

.dish-card {`r`n  width: calc(50% - 16rpx);`r`n  min-height: 192rpx;`r`n  margin-right: 16rpx;`r`n  margin-bottom: 16rpx;`r`n  padding: 18rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: #fbfdf9;
  border: 1rpx solid rgba(38, 87, 66, 0.06);
}

.dish-cover,
.recommend-cover {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #12824f;
  font-weight: 800;
  background: linear-gradient(135deg, #e6f8e9, #fff8dd);
}

.dish-cover {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  font-size: 25rpx;
}

.dish-info {
  margin-top: 16rpx;
}

.dish-name,
.dish-meta {
  display: block;
}

.dish-name {
  overflow: hidden;
  color: #213830;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-meta {
  margin-top: 8rpx;
  color: #7f8d87;
  font-size: 22rpx;
  line-height: 1.25;
}

.dish-tags,
.recommend-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.dish-tags {
  margin-top: 12rpx;
  max-height: 44rpx;
  overflow: hidden;
}

.dish-tags text,
.recommend-tags text {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  color: #27a467;
  background: #edf8ef;
  font-size: 20rpx;
  line-height: 1.1;
}

.recommend-section {
  margin-bottom: 24rpx;
}

.recommend-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 24rpx;
}

.recommend-card {
  display: flex;
  gap: 18rpx;
  padding: 20rpx;
  border-radius: 26rpx;
  background: #fbfdf9;
  border: 1rpx solid rgba(38, 87, 66, 0.06);
}

.recommend-cover {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
}

.recommend-main {
  flex: 1;
  min-width: 0;
}

.recommend-topline {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.recommend-name {
  max-width: 250rpx;
  overflow: hidden;
  color: #213830;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommend-reason {
  flex: none;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  color: #df7e36;
  background: #fff3df;
  font-size: 20rpx;
  line-height: 1.1;
}

.recommend-desc {
  display: block;
  margin-top: 10rpx;
  color: #71817b;
  font-size: 23rpx;
  line-height: 1.45;
}

.recommend-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 16rpx;
}

.recommend-tags {
  flex: 1;
  min-width: 0;
}

.recommend-action {
  flex: none;
  width: 150rpx;
  height: 54rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #16c875;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 54rpx;
}

.ai-dock {
  position: fixed;
  right: 24rpx;
  bottom: calc(128rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  z-index: 18;
}

.ai-button {
  width: 100%;
  height: 92rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #19c875, #11ad63);
  box-shadow: 0 18rpx 38rpx rgba(16, 185, 105, 0.28);
}

.ai-mark {
  flex: none;
  width: 54rpx;
  height: 54rpx;
  border-radius: 18rpx;
  color: #0f8c55;
  background: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 54rpx;
  text-align: center;
}

.ai-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.ai-title {
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.2;
}

.ai-desc {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 21rpx;
  line-height: 1.2;
}

.ai-arrow {
  flex: none;
  font-size: 44rpx;
  line-height: 1;
}


