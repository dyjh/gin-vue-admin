.home {
  min-height: 100vh;
  background: #f4f7f4;
}

.home-hero {
  position: relative;
  width: 100%;
  height: 402rpx;
  overflow: hidden;
  background: #fffaf2;
}

.home-hero::after {
  position: absolute;
  z-index: 1;
  right: 0;
  bottom: 0;
  left: 0;
  height: 72rpx;
  background: linear-gradient(180deg, rgba(244, 247, 244, 0), #f4f7f4);
  content: "";
}

.home-hero__image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}


.home-main {
  position: relative;
  z-index: 3;
  margin-top: 0;
  padding: 0 24rpx 48rpx;
}

.home-workbench {
  padding: 18rpx;
  border: 1rpx solid rgba(219, 230, 222, 0.92);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 16rpx 42rpx rgba(22, 54, 35, 0.09);
}

.search-bar {
  display: flex;
  height: 74rpx;
  align-items: center;
  gap: 14rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  background: #f4f7f4;
}

.search-bar__input {
  min-width: 0;
  height: 100%;
  flex: 1;
  color: #26342c;
  font-size: 25rpx;
}

.create-entry {
  display: flex;
  width: 100%;
  height: 94rpx;
  align-items: center;
  gap: 14rpx;
  margin-top: 14rpx;
  padding: 0 18rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #17ad62 0%, #0a8a50 100%);
  box-shadow: 0 10rpx 24rpx rgba(11, 139, 80, 0.18);
  color: #fff;
  text-align: left;
}

.create-entry__icon {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.16);
}

.create-entry__copy,
.suggestion-card__copy {
  min-width: 0;
  flex: 1;
}

.create-entry__title,
.create-entry__meta,
.suggestion-card__title,
.suggestion-card__meta,
.home-section__subtitle {
  display: block;
}

.create-entry__title {
  font-size: 28rpx;
  font-weight: 850;
  line-height: 1.2;
}

.create-entry__meta {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 19rpx;
  line-height: 1.2;
}

.suggestion-card {
  display: flex;
  width: 100%;
  min-height: 100rpx;
  align-items: center;
  gap: 14rpx;
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid #dce9df;
  border-radius: 22rpx;
  background: #edf7ef;
  text-align: left;
}

.suggestion-card__icon {
  display: flex;
  width: 54rpx;
  height: 54rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #2dab64;
}

.suggestion-card__title {
  color: #1d3225;
  font-size: 24rpx;
  font-weight: 850;
  line-height: 1.2;
}

.suggestion-card__meta {
  margin-top: 6rpx;
  overflow: hidden;
  color: #728178;
  font-size: 18rpx;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.suggestion-card__action {
  display: flex;
  height: 52rpx;
  flex: none;
  align-items: center;
  gap: 2rpx;
  padding: 0 12rpx 0 16rpx;
  border-radius: 26rpx;
  background: #fff;
  color: #178f53;
  font-size: 20rpx;
  font-weight: 800;
}

.home-section {
  margin-top: 18rpx;
  padding: 24rpx 20rpx 6rpx;
  border: 1rpx solid #e5ece7;
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(17, 43, 27, 0.035);
}

.home-section--recommend {
  margin-top: 18rpx;
}

.home-section--recommend-empty {
  padding-bottom: 20rpx;
}

.home-section__head {
  display: flex;
  min-height: 52rpx;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.home-section__title-group {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 12rpx;
}

.home-section__title {
  color: #17231c;
  font-size: 30rpx;
  font-weight: 850;
  line-height: 1.25;
}

.home-section__count {
  padding: 6rpx 10rpx;
  border-radius: 999rpx;
  background: #eef3ef;
  color: #75827a;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1;
}

.home-section__subtitle {
  margin-top: 6rpx;
  color: #89948e;
  font-size: 19rpx;
  line-height: 1.25;
}

.home-section__more {
  display: flex;
  height: 52rpx;
  flex: none;
  align-items: center;
  gap: 3rpx;
  color: #168f53;
  font-size: 21rpx;
  font-weight: 750;
}

.home-section__more--neutral {
  color: #6f7d75;
}

.filter-row {
  display: flex;
  height: 52rpx;
  align-items: center;
  gap: 8rpx;
  margin: 12rpx 0 4rpx;
  overflow: hidden;
}

.filter-chip {
  display: flex;
  width: 114rpx;
  height: 46rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  padding: 0;
  border: 1rpx solid transparent;
  border-radius: 23rpx;
  background: #f3f6f3;
  color: #77847d;
  font-size: 21rpx;
  font-weight: 650;
  line-height: 1;
  white-space: nowrap;
}

.filter-chip--active {
  border-color: #cfe7d7;
  background: #e8f5ec;
  color: #148e50;
  font-weight: 800;
}

.filter-chip--category {
  width: 134rpx;
}

.home-dish-list,
.recommend-list {
  width: 100%;
}

.home-dish,
.recommend-row {
  display: flex;
  width: 100%;
  align-items: center;
  gap: 16rpx;
  border-bottom: 1rpx solid #edf1ee;
  text-align: left;
}

.home-dish {
  min-height: 118rpx;
  padding: 15rpx 0;
}

.recommend-row {
  min-height: 122rpx;
  padding: 16rpx 0;
}

.home-dish:last-child,
.recommend-row:last-child {
  border-bottom: 0;
}

.home-dish__image {
  width: 96rpx;
  height: 80rpx;
  flex: none;
  border-radius: 16rpx;
  background: #eef2ef;
}

.home-dish__body,
.recommend-row__body {
  min-width: 0;
  flex: 1;
}

.home-dish__name,
.home-dish__meta,
.recommend-row__name,
.recommend-row__meta {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-dish__name,
.recommend-row__name {
  color: #18231d;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.3;
}

.home-dish__meta,
.recommend-row__meta {
  margin-top: 7rpx;
  color: #7a8780;
  font-size: 20rpx;
  line-height: 1.3;
}

.home-dish__tail {
  display: flex;
  flex: none;
  align-items: center;
  gap: 8rpx;
}

.home-dish__badge {
  min-width: 68rpx;
  padding: 7rpx 10rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 750;
  line-height: 1;
  text-align: center;
}

.home-dish__badge--green {
  background: #e8f6ed;
  color: #179554;
}

.home-dish__badge--blue {
  background: #edf4fb;
  color: #4d88b3;
}

.home-dish__badge--warm {
  background: #fff3e7;
  color: #d47d2f;
}

.home-dish__badge--gray {
  background: #f0f3f1;
  color: #7a8780;
}

.home-empty {
  padding: 38rpx 0;
  color: #8a958f;
  font-size: 23rpx;
  text-align: center;
}

.recommend-row__image {
  width: 98rpx;
  height: 82rpx;
  flex: none;
  border-radius: 16rpx;
  background: #eef2ef;
}

.recommend-row__action {
  display: flex;
  min-width: 92rpx;
  height: 50rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  padding: 0 16rpx;
  border: 1rpx solid #73bb92;
  border-radius: 25rpx;
  color: #168e52;
  font-size: 19rpx;
  font-weight: 750;
  line-height: 1;
}

.recommend-row__action--done {
  border-color: #dce9e1;
  background: #edf5ef;
  color: #6c7f75;
}
