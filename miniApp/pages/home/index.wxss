.home {
  min-height: 100vh;
  background: #f6f9f6;
}

.home-hero {
  position: relative;
  width: 100%;
  min-height: 356rpx;
  overflow: hidden;
  background: #fffaf2;
}

.home-hero__image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.home-hero__copy {
  position: absolute;
  z-index: 2;
  left: 34rpx;
  width: 46%;
}

.home-hero__title,
.home-hero__subtitle {
  display: block;
}

.home-hero__title {
  color: #087443;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.1;
}

.home-hero__subtitle {
  margin-top: 12rpx;
  color: #4e6257;
  font-size: 22rpx;
  line-height: 1.45;
}

.home-main {
  position: relative;
  z-index: 3;
  margin-top: -38rpx;
  padding: 0 24rpx 214rpx;
}

.search-bar {
  display: flex;
  height: 78rpx;
  align-items: center;
  gap: 14rpx;
  padding: 0 26rpx;
  border: 1rpx solid #e1e9e3;
  border-radius: 39rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(17, 45, 29, 0.08);
}

.search-bar__input {
  min-width: 0;
  height: 100%;
  flex: 1;
  color: #26342c;
  font-size: 25rpx;
}

.entry-panel {
  margin-top: 16rpx;
  padding: 14rpx;
  border-radius: 24rpx;
  background: #edf8f1;
}

.entry-panel__primary {
  display: flex;
  width: 100%;
  height: 70rpx;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border-radius: 35rpx;
  background: linear-gradient(90deg, #0ca35a, #087b49);
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
}

.entry-panel__quick {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 12rpx;
}

.entry-panel__quick-button {
  display: flex;
  min-width: 0;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 1rpx solid #e2ece5;
  border-radius: 14rpx;
  background: #fff;
  color: #188e55;
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
}

.home-section {
  margin-top: 18rpx;
  padding: 20rpx 18rpx 4rpx;
  border: 1rpx solid #e8eee9;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(16, 38, 26, 0.035);
}

.home-section--recommend {
  margin-top: 20rpx;
}

.home-section__head {
  display: flex;
  min-height: 48rpx;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.home-section__title-group {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.home-section__title {
  color: #17221c;
  font-size: 30rpx;
  font-weight: 850;
  line-height: 1.25;
}

.home-section__arrow {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  align-items: center;
  justify-content: center;
}

.home-section__more {
  display: flex;
  height: 48rpx;
  align-items: center;
  gap: 4rpx;
  color: #168f53;
  font-size: 22rpx;
  font-weight: 700;
}

.filter-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 8rpx 0 4rpx;
  overflow: hidden;
}

.filter-chip {
  display: flex;
  height: 46rpx;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  padding: 0 18rpx;
  border-radius: 23rpx;
  background: #f4f6f4;
  color: #77847d;
  font-size: 21rpx;
  font-weight: 650;
  white-space: nowrap;
}

.filter-chip--active {
  background: #e6f5ec;
  color: #159b55;
  font-weight: 800;
}

.filter-chip--category {
  min-width: 132rpx;
}

.home-dish-list,
.recommend-list {
  width: 100%;
}

.home-dish {
  display: flex;
  width: 100%;
  min-height: 112rpx;
  align-items: center;
  gap: 16rpx;
  padding: 13rpx 0;
  border-bottom: 1rpx solid #edf1ee;
  text-align: left;
}

.home-dish:last-child {
  border-bottom: 0;
}

.home-dish__image {
  width: 94rpx;
  height: 78rpx;
  flex: none;
  border-radius: 14rpx;
  background: #eef2ef;
}

.home-dish__body {
  min-width: 0;
  flex: 1;
}

.home-dish__name,
.home-dish__meta {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-dish__name {
  color: #18231d;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.3;
}

.home-dish__meta {
  margin-top: 7rpx;
  color: #7a8780;
  font-size: 20rpx;
  line-height: 1.3;
}

.home-dish__tail {
  display: flex;
  flex: none;
  align-items: center;
  gap: 8rpx;
}

.home-dish__badge {
  min-width: 72rpx;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 750;
  line-height: 1;
  text-align: center;
}

.home-dish__badge--green {
  background: #e8f6ed;
  color: #179554;
}

.home-dish__badge--blue {
  background: #edf4fb;
  color: #4d88b3;
}

.home-dish__badge--warm {
  background: #fff3e7;
  color: #d47d2f;
}

.home-empty {
  padding: 36rpx 0;
  color: #8a958f;
  font-size: 23rpx;
  text-align: center;
}

.recommend-row {
  display: flex;
  min-height: 116rpx;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #edf1ee;
}

.recommend-row:last-child {
  border-bottom: 0;
}

.recommend-row__image {
  width: 98rpx;
  height: 82rpx;
  flex: none;
  border-radius: 14rpx;
  background: #eef2ef;
}

.recommend-row__body {
  min-width: 0;
  flex: 1;
}

.recommend-row__name,
.recommend-row__meta {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommend-row__name {
  color: #17221c;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.3;
}

.recommend-row__meta {
  margin-top: 7rpx;
  color: #7b8982;
  font-size: 20rpx;
  line-height: 1.3;
}

.recommend-row__action {
  width: 126rpx;
  height: 54rpx;
  flex: none;
  border: 2rpx solid #159b55;
  border-radius: 27rpx;
  color: #159b55;
  font-size: 20rpx;
  font-weight: 750;
  line-height: 1;
}

.recommend-row__action--done {
  border-color: #dce9e1;
  background: #edf6f0;
  color: #698078;
}

.what-to-eat-dock {
  position: fixed;
  z-index: 45;
  right: 20rpx;
  bottom: 0;
  left: 20rpx;
  display: flex;
  height: 94rpx;
  align-items: center;
  gap: 14rpx;
  padding: 12rpx 14rpx 12rpx 16rpx;
  border: 1rpx solid #dce8df;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 10rpx 32rpx rgba(16, 38, 26, 0.12);
}

.what-to-eat-dock__icon {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #48b946;
}

.what-to-eat-dock__copy {
  min-width: 0;
  flex: 1;
}

.what-to-eat-dock__title,
.what-to-eat-dock__meta {
  display: block;
}

.what-to-eat-dock__title {
  color: #1d2822;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.2;
}

.what-to-eat-dock__meta {
  margin-top: 5rpx;
  overflow: hidden;
  color: #7b8982;
  font-size: 19rpx;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.what-to-eat-dock__button {
  display: flex;
  height: 62rpx;
  flex: none;
  align-items: center;
  gap: 5rpx;
  padding: 0 22rpx;
  border-radius: 31rpx;
  background: linear-gradient(90deg, #13ad60, #078b50);
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
}
