<view class="page home">
  <view class="home-hero">
    <image class="home-hero__image" src="{{heroImage}}" mode="aspectFill" />
  </view>

  <view class="home-main">
    <view class="home-workbench">
      <view class="search-bar">
        <app-icon name="search" tone="gray" size="{{19}}" />
        <input
          class="search-bar__input"
          value="{{query}}"
          placeholder="搜索菜名、分类或食材"
          confirm-type="search"
          bindinput="search"
        />
      </view>

      <button class="create-entry" bindtap="openManual">
        <view class="create-entry__icon">
          <app-icon name="plus" tone="white" size="{{20}}" />
        </view>
        <view class="create-entry__copy">
          <text class="create-entry__title">添加菜品</text>
          <text class="create-entry__meta">记录常做的菜，整理自己的菜品库</text>
        </view>
        <app-icon name="chevron-right" tone="white" size="{{16}}" />
      </button>
    </view>

    <button wx:if="{{suggestionFeature}}" class="suggestion-card" bindtap="openWhatToEat">
      <view class="suggestion-card__icon">
        <app-icon name="sparkles" tone="white" size="{{20}}" />
      </view>
      <view class="suggestion-card__copy">
        <text class="suggestion-card__title">{{suggestionFeature.title}}</text>
        <text class="suggestion-card__meta">{{suggestionFeature.description}}</text>
      </view>
      <view class="suggestion-card__action">
        <text>{{suggestionFeature.actionText}}</text>
        <app-icon name="chevron-right" tone="green" size="{{14}}" />
      </view>
    </button>

    <view class="home-section home-section--mine">
      <view class="home-section__head">
        <view class="home-section__title-group">
          <text class="home-section__title">我的菜品</text>
          <text class="home-section__count">{{dishTotal}} 道</text>
        </view>
        <button class="home-section__more home-section__more--neutral" bindtap="openDishLibrary">
          <text>全部</text>
          <app-icon name="chevron-right" tone="gray" size="{{15}}" />
        </button>
      </view>

      <view class="filter-row">
        <button
          class="filter-chip {{dishFilter === 'recent' ? 'filter-chip--active' : ''}}"
          data-filter="recent"
          bindtap="setDishFilter"
        >最近编辑</button>
        <button
          class="filter-chip {{dishFilter === 'frequent' ? 'filter-chip--active' : ''}}"
          data-filter="frequent"
          bindtap="setDishFilter"
        >常点菜品</button>
        <button
          class="filter-chip filter-chip--category {{dishFilter === 'category' ? 'filter-chip--active' : ''}}"
          data-filter="category"
          bindtap="setDishFilter"
        >
          <text>{{categoryLabel || "分类筛选"}}</text>
          <app-icon name="filter" tone="{{dishFilter === 'category' ? 'green' : 'gray'}}" size="{{13}}" />
        </button>
      </view>

      <view class="home-dish-list">
        <button
          class="home-dish"
          wx:for="{{dishes}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="openDish"
        >
          <image class="home-dish__image" src="{{item.coverUrl}}" mode="aspectFill" />
          <view class="home-dish__body">
            <text class="home-dish__name">{{item.name}}</text>
            <text class="home-dish__meta">{{item.category}} · 适合 {{item.serving}} 人</text>
          </view>
          <view class="home-dish__tail">
            <text class="home-dish__badge home-dish__badge--{{item.homeBadge.tone}}">{{item.homeBadge.label}}</text>
            <app-icon name="chevron-right" tone="gray" size="{{15}}" />
          </view>
        </button>
        <view wx:if="{{!dishes.length}}" class="home-empty">没有找到符合条件的菜品</view>
      </view>
    </view>

    <view class="home-section home-section--recommend {{recommendations.length ? '' : 'home-section--recommend-empty'}}">
      <view class="home-section__head">
        <view class="home-section__title-group">
          <view>
            <text class="home-section__title">菜品推荐</text>
            <text class="home-section__subtitle">从平台菜库挑选</text>
          </view>
        </view>
        <button class="home-section__more" bindtap="openRecommendations">
          <text>更多</text>
          <app-icon name="chevron-right" tone="gray" size="{{15}}" />
        </button>
      </view>

      <view class="recommend-list">
        <view
          class="recommend-row"
          wx:for="{{recommendations}}"
          wx:key="id"
          data-id="{{item.recommendationId}}"
          bindtap="openRecommendation"
        >
          <image class="recommend-row__image" src="{{item.coverUrl}}" mode="aspectFill" lazy-load />
          <view class="recommend-row__body">
            <text class="recommend-row__name">{{item.name}}</text>
            <text class="recommend-row__meta">{{item.category}} · {{item.author.name}}</text>
          </view>
          <button
            class="recommend-row__action {{item.copied ? 'recommend-row__action--done' : ''}}"
            data-id="{{item.recommendationId}}"
            catchtap="copyRecommendation"
          >{{item.copied ? "已加入" : "加入"}}</button>
        </view>
      </view>
    </view>
  </view>
</view>
