.entry-tabs {
  position: relative;
  z-index: 3;
  display: flex;
  height: 100rpx;
  margin: 0 44rpx;
  border: 1rpx solid #e4ebe6;
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(16, 38, 26, 0.06);
}

.entry-tabs__item {
  position: relative;
  display: flex;
  height: 100%;
  flex: 1;
  align-items: center;
  justify-content: center;
  color: #849089;
  font-size: 27rpx;
  font-weight: 750;
}

.entry-tabs__item--active {
  color: #159b55;
}

.entry-tabs__item--active::after {
  position: absolute;
  top: auto;
  right: auto;
  bottom: 0;
  left: 50%;
  display: block;
  width: 132rpx;
  height: 6rpx;
  border: 0;
  border-radius: 999rpx;
  background: #159b55;
  content: "";
  transform: translateX(-50%);
}

.content.content--tight,
.extract-entry {
  padding-right: 44rpx;
  padding-left: 44rpx;
}

.content.content--tight {
  padding-top: 4rpx;
}

.extract-entry {
  padding-top: 20rpx;
  padding-bottom: 96rpx;
}

.extract-card {
  min-height: 0;
  padding: 32rpx 28rpx 30rpx;
}

.extract-card__head {
  display: flex;
  align-items: flex-start;
  margin-bottom: 30rpx;
}

.extract-card__heading {
  min-width: 0;
  flex: 1;
}

.extract-card__title-row {
  display: flex;
  min-height: 52rpx;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.extract-card__head .section-title,
.extract-card__head .section-subtitle {
  display: block;
}

.extract-card__head .section-subtitle {
  margin-top: 12rpx;
  line-height: 1.65;
}

.extract-card__status {
  min-height: 48rpx;
  flex: none;
  padding: 0 18rpx;
  font-size: 22rpx;
  white-space: nowrap;
}

.extract-card__text {
  min-height: 260rpx;
  padding: 24rpx;
}

.extract-card__upload {
  display: flex;
  width: 100%;
  height: 244rpx;
  align-items: center;
  justify-content: center;
  margin: 30rpx 0;
  overflow: hidden;
  border: 2rpx dashed #add4bd;
  border-radius: 20rpx;
  background: #f7fbf8;
  color: #159b55;
}

.extract-card__upload image {
  width: 100%;
  height: 100%;
}

.extract-card__upload view {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  font-weight: 750;
  line-height: 1.35;
}

.extract-card__upload .caption {
  margin-top: 2rpx;
  font-weight: 400;
}

.extract-card > .btn {
  height: 88rpx;
}

.recognition-result__summary {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin: 24rpx 0;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #f4f8f5;
}

.recognition-result__summary image {
  width: 130rpx;
  height: 110rpx;
  border-radius: 14rpx;
}
