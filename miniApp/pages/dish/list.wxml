<view class="page dish-library-page">
  <app-hero
    image="/assets/images/subpage-cat-dish-library-v1.png"
    title="全部菜品"
    subtitle="查看和管理你记录的每一道菜"
  />

  <view class="dish-library__toolbar">
    <view class="dish-library__search">
      <app-icon name="search" tone="gray" size="{{18}}" />
      <input
        value="{{keyword}}"
        placeholder="搜索菜名、分类或标签"
        placeholder-class="dish-library__placeholder"
        confirm-type="search"
        bindinput="inputSearch"
        bindconfirm="confirmSearch"
      />
      <button wx:if="{{keyword}}" class="dish-library__clear" aria-label="清空搜索" bindtap="clearSearch">
        <app-icon name="close" tone="gray" size="{{15}}" />
      </button>
    </view>
    <button class="dish-library__add" aria-label="添加菜品" bindtap="addDish">
      <app-icon name="plus" tone="green" size="{{20}}" />
    </button>
  </view>

  <view class="dish-library__head">
    <view>
      <text class="dish-library__title">个人菜品库</text>
      <text class="dish-library__summary">按分类查看，也可以直接搜索</text>
    </view>
    <text class="dish-library__total">{{libraryTotal}} 道</text>
  </view>

  <view class="dish-library__panel">
    <view class="dish-library__categories">
      <button
        wx:for="{{categories}}"
        wx:key="value"
        class="dish-library__category {{activeCategory === item.value ? 'active' : ''}}"
        data-category="{{item.value}}"
        bindtap="selectCategory"
      >
        <text>{{item.label}}</text>
        <text wx:if="{{item.value === activeCategory}}">{{total}} 道</text>
      </button>
    </view>

    <view class="dish-library__results">
      <view class="dish-library__result-head">
        <text>{{activeCategory || "全部菜品"}}</text>
        <text wx:if="{{keyword}}">“{{keyword}}”的结果</text>
      </view>

      <view wx:if="{{!loaded}}" class="dish-library__loading">正在加载菜品...</view>

      <view wx:elif="{{list.length}}" class="dish-library__list">
        <dish-row
          wx:for="{{list}}"
          wx:key="id"
          dish="{{item}}"
          compact="{{true}}"
          bind:open="openDish"
        />
        <view wx:if="{{loading}}" class="dish-library__loading">正在加载更多...</view>
        <view wx:elif="{{list.length >= total}}" class="dish-library__loading dish-library__loading--end">已经看到全部菜品</view>
      </view>

      <view wx:else class="dish-library__empty">
        <app-icon name="dish" tone="gray" size="{{32}}" />
        <text class="dish-library__empty-title">{{keyword ? "没有找到相关菜品" : "这个分类还没有菜品"}}</text>
        <text>{{keyword ? "换个关键词或分类试试" : "可以先添加一道菜"}}</text>
      </view>
    </view>
  </view>
</view>