<view class="page">
  <app-hero
    image="/assets/images/dish-form-cat-writing-v1.jpg"
    title="编辑菜品"
    subtitle="调整资料，并同步到菜品库"
  />
  <view wx:if="{{dish}}" class="content content--tight">
    <dish-form value="{{dish}}" mode="edit" cover-feature="{{coverFeature}}" bind:save="save" />
  </view>
</view>
