page {
  min-height: 100%;
  background: #f8faf7;
  color: #1b241f;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view, text, image, button, input, textarea, scroll-view, swiper, picker {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  line-height: 1;
}

button::after {
  display: none;
}

.page {
  min-height: 100vh;
  background: #f8faf7;
}

.page--white {
  background: #fff;
}

.content {
  padding: 28rpx 32rpx calc(164rpx + env(safe-area-inset-bottom));
}

.content--tight {
  padding-top: 16rpx;
}

.content--flush {
  padding-left: 0;
  padding-right: 0;
}

.card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #e8eee9;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 12rpx 32rpx rgba(16, 38, 26, 0.045);
}

.band {
  padding: 28rpx 32rpx;
  background: #fff;
}

.divider {
  height: 1rpx;
  background: #edf1ee;
}

.section-title {
  color: #1b241f;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.3;
}

.section-subtitle, .muted {
  color: #7b8982;
  font-size: 24rpx;
  line-height: 1.55;
}

.caption {
  color: #8a958f;
  font-size: 22rpx;
  line-height: 1.45;
}

.strong {
  font-weight: 800;
}

.green {
  color: #159b55;
}

.danger {
  color: #d8564f;
}

.pill {
  display: inline-flex;
  min-height: 48rpx;
  align-items: center;
  justify-content: center;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #e9f8ef;
  color: #159b55;
  font-size: 24rpx;
  font-weight: 700;
}

.pill--warm {
  background: #fff4e6;
  color: #d97812;
}

.pill--gray {
  background: #f0f3f1;
  color: #69766f;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.tag {
  min-height: 48rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #e9f8ef;
  color: #159b55;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 28rpx;
}

.tag--outline {
  border: 1rpx solid #b9dfc9;
  background: #fff;
}

.tag--selected {
  background: #159b55;
  color: #fff;
}

.btn {
  display: flex;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}

.btn--primary {
  background: linear-gradient(90deg, #20b866 0%, #0a8e52 100%);
  color: #fff;
}

.btn--outline {
  border: 2rpx solid #93cdae;
  background: #fff;
  color: #159b55;
}

.btn--soft {
  background: #e9f8ef;
  color: #159b55;
}

.btn--danger {
  border: 2rpx solid #edaaa5;
  background: #fff;
  color: #d8564f;
}

.btn--small {
  width: auto;
  height: 64rpx;
  padding: 0 26rpx;
  font-size: 25rpx;
}

.btn[disabled] {
  background: #dce4df;
  color: #94a099;
}

.icon-button {
  display: flex;
  width: 68rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #dfe8e2;
  border-radius: 50%;
  background: #fff;
}

.field {
  margin-bottom: 28rpx;
}

.field__label {
  display: flex;
  min-height: 48rpx;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
  color: #1b241f;
  font-size: 28rpx;
  font-weight: 800;
}

.field__control {
  width: 100%;
  min-height: 84rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #dfe8e2;
  border-radius: 16rpx;
  background: #fbfcfb;
  color: #1b241f;
  font-size: 28rpx;
  line-height: 1.5;
}

textarea.field__control {
  min-height: 168rpx;
}

.field__help {
  margin-top: 10rpx;
  color: #8a958f;
  font-size: 22rpx;
  line-height: 1.5;
}

.row {
  display: flex;
  min-height: 96rpx;
  align-items: center;
  gap: 20rpx;
}

.row__body {
  min-width: 0;
  flex: 1;
}

.row__title {
  color: #1b241f;
  font-size: 28rpx;
  font-weight: 750;
  line-height: 1.4;
}

.row__meta {
  margin-top: 6rpx;
  color: #7b8982;
  font-size: 23rpx;
  line-height: 1.4;
}

.list > .row + .row {
  border-top: 1rpx solid #edf1ee;
}

.segmented {
  display: flex;
  height: 76rpx;
  padding: 6rpx;
  border-radius: 16rpx;
  background: #eef3ef;
}

.segmented__item {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  color: #75827b;
  font-size: 26rpx;
  font-weight: 700;
}

.segmented__item--active {
  background: #fff;
  color: #159b55;
  box-shadow: 0 5rpx 14rpx rgba(16, 38, 26, 0.06);
}

.bottom-dock {
  position: fixed;
  z-index: 40;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e7ede9;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 -10rpx 30rpx rgba(16, 38, 26, 0.05);
}

.bottom-dock__row {
  display: flex;
  gap: 20rpx;
}

.bottom-dock__row .btn {
  flex: 1;
}

.cover {
  display: block;
  width: 100%;
  border-radius: 24rpx;
  background: #eef3ef;
}

.photo {
  object-fit: cover;
}

.switch {
  transform: scale(0.86);
  transform-origin: right center;
}

.sheet-mask {
  position: fixed;
  z-index: 70;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(16, 32, 24, 0.34);
}

.sheet {
  width: 100%;
  max-height: 82vh;
  padding: 22rpx 32rpx calc(30rpx + env(safe-area-inset-bottom));
  overflow: auto;
  border-radius: 30rpx 30rpx 0 0;
  background: #fff;
}

.sheet__handle {
  width: 84rpx;
  height: 8rpx;
  margin: 0 auto 28rpx;
  border-radius: 999rpx;
  background: #dce5df;
}

.grid-2 {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #20b866;
}
